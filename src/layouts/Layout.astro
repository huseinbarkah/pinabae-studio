---
import '../styles/global.css';
import WhatsAppBubble from '../components/WhatsAppBubble.astro';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl } from '../i18n/utils';
import { supabase } from '../lib/supabase';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	image?: string;
	schema?: string;
	type?: string;
	noindex?: boolean;
	ogTitle?: string;
	ogDescription?: string;
	hideWhatsApp?: boolean;
}

const urlLang = getLangFromUrl(Astro.url);

// Ambil settings dari database untuk verifikasi
const { data: settings } = await supabase.from('site_settings').select('*').eq('id', 1).single();

const { 
	title = settings?.site_title || "Pinabae Studio | Jasa Pembuatan Website Profesional", 
	description = settings?.site_description || "Jasa Digital Agency di Sumbawa yang membantu UMKM, bisnis, dan personal brand meningkatkan kredibilitas, traffic, dan penjualan melalui website modern dan strategi digital.",
	lang = urlLang,
	image = "/og-image.jpg",
	schema,
	type = "website",
	noindex = false,
	ogTitle,
	ogDescription,
	hideWhatsApp = false
} = Astro.props;

// Gunakan canonical URL dengan domain utama
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://pinabae.site').href;
const resolvedImageWithDomain = new URL(image, Astro.site || 'https://pinabae.site').href;
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Local SEO Geo Tags -->
		<meta name="geo.region" content="ID-NB" />
		<meta name="geo.placename" content="Sumbawa Besar, Nusa Tenggara Barat" />
		<meta name="geo.position" content="-8.49858;117.43213" />
		<meta name="ICBM" content="-8.49858, 117.43213" />

		<!-- Open Graph / Facebook -->
		<meta property="og:site_name" content="Pinabae Studio" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={ogTitle || title} />
		<meta property="og:description" content={ogDescription || description} />
		<meta property="og:image" content={resolvedImageWithDomain} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={ogTitle || title} />
		<meta property="twitter:description" content={ogDescription || description} />
		<meta property="twitter:image" content={resolvedImageWithDomain} />
		
		<!-- SEO Robots -->
		{noindex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow" />
		)}
		
		<!-- Verifikasi Search Console & Bing -->
		{settings?.gsc_verification && <meta name="google-site-verification" content={settings.gsc_verification} />}
		{settings?.bing_verification && <meta name="msvalidate.01" content={settings.bing_verification} />}

		<!-- Google Analytics 4 -->
		{settings?.google_analytics && (
			<>
				<script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${settings.google_analytics}`} async></script>
				<script is:inline define:vars={{ gaId: settings.google_analytics }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', gaId);
				</script>
			</>
		)}

		<!-- Google Tag Manager -->
		{settings?.gtm_code && (
			<script is:inline define:vars={{ gtmId: settings.gtm_code }}>
				(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
				new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
				j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
				'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
				})(window,document,'script','dataLayer',gtmId);
			</script>
		)}
		
		<!-- Google Fonts: Plus Jakarta Sans -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap">
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
		</noscript>
		
		<!-- Schema.org JSON-LD -->
		{schema ? (
			<script type="application/ld+json" set:html={schema} />
		) : (
			<script type="application/ld+json" set:html={`
			{
			 "@context":"https://schema.org",
			 "@type":"ProfessionalService",
			 "name":"Pinabae Studio",
			 "url":"https://pinabae.site",
			 "logo":"https://pinabae.site/logo.png",
			 "description":"Digital Agency di Sumbawa yang membantu bisnis berkembang melalui website profesional dan strategi digital.",
			 "address":{
			   "@type":"PostalAddress",
			   "addressLocality":"Sumbawa Besar",
			   "addressRegion":"Nusa Tenggara Barat",
			   "addressCountry":"ID"
			 }
			}
			`} />
		)}
		<script type="application/ld+json" set:html={`
		{
		  "@context": "https://schema.org",
		  "@type": "WebSite",
		  "name": "Pinabae Studio",
		  "url": "https://pinabae.site/"
		}
		`} />
	</head>
	<body class="flex flex-col min-h-screen">
		<!-- Google Tag Manager (noscript) -->
		{settings?.gtm_code && (
			<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${settings.gtm_code}`}
			height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		)}
		
		<slot />
		{!hideWhatsApp && <WhatsAppBubble />}
		
		<!-- Smooth Scrolling (Lenis), Lucide Icons, & Service Worker -->
		<script>
		  import Lenis from 'lenis';
		  import { 
		    createIcons, MapPin, Sparkles, Target, Flag, CheckCircle2, Lightbulb, Handshake, ShieldCheck, 
		    TrendingUp, MessageCircle, ClipboardList, PenTool, Code2, Rocket, LifeBuoy, User, Users, 
		    ArrowRight, CheckCircle, Box, Building2, LayoutTemplate, BriefcaseBusiness, BookOpen, Search, 
		    Info, Mail, Phone, Clock3, MessageSquare, 
		    UserSquare, UserSearch, SearchX, ShieldAlert, TrendingDown, MonitorOff, ChevronDown, Menu, X, Briefcase
		  } from 'lucide';

		  document.addEventListener('astro:page-load', () => {
		    // Initialize Lenis
		    const lenis = new Lenis({
			  autoRaf: true,
		    });

		    // Initialize Lucide with specific icons (Tree-shaking)
		    createIcons({
			  icons: {
			    MapPin, Sparkles, Target, Flag, CheckCircle2, Lightbulb, Handshake, ShieldCheck, 
			    TrendingUp, MessageCircle, ClipboardList, PenTool, Code2, Rocket, LifeBuoy, User, Users, 
			    ArrowRight, CheckCircle, Box, Building2, LayoutTemplate, BriefcaseBusiness, BookOpen, Search, 
			    Info, Mail, Phone, Clock3, MessageSquare, 
			    UserSquare, UserSearch, SearchX, ShieldAlert, TrendingDown, MonitorOff, ChevronDown, Menu, X, Briefcase
			  },
			  nameAttr: 'data-lucide'
		    });
		  });

		  // Register Service Worker (only once)
		  if ('serviceWorker' in navigator) {
		    window.addEventListener('load', () => {
		      navigator.serviceWorker.register('/sw.js').catch(err => {
		        console.log('ServiceWorker registration failed: ', err);
		      });
		    });
		  }
		</script>
	</body>
</html>
