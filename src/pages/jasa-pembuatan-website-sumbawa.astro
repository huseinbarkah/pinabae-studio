---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

// FAQ Schema specifically for Local FAQ
const faqs = [
  {
    question: "Apakah Pinabae Studio menerima pembuatan website untuk UMKM di Sumbawa?",
    answer: "Ya, kami sangat mendukung pertumbuhan UMKM di Sumbawa dengan menyediakan paket pembuatan website yang terjangkau dan profesional."
  },
  {
    question: "Berapa lama proses pembuatan website?",
    answer: "Proses pembuatan website biasanya memakan waktu 1 hingga 3 minggu tergantung pada kompleksitas fitur dan kesiapan materi konten dari Anda."
  },
  {
    question: "Apakah website yang dibuat sudah SEO friendly?",
    answer: "Tentu. Setiap website yang kami kembangkan sudah dioptimasi dari sisi struktur (On-Page SEO), kecepatan (Core Web Vitals), dan responsif untuk mobile."
  },
  {
    question: "Apakah saya bisa request desain website khusus?",
    answer: "Sangat bisa. Sebagai Web Developer Sumbawa, kami menyediakan layanan kustomisasi desain agar sesuai dengan identitas brand bisnis Anda."
  },
  {
    question: "Apakah ada biaya bulanan yang harus dibayar?",
    answer: "Tidak ada biaya bulanan untuk pembuatan websitenya sendiri. Anda hanya perlu memperpanjang domain dan hosting setiap tahun."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Pinabae Studio - Jasa Pembuatan Website Sumbawa",
  "image": "https://pinabae-studio.vercel.app/logo.png",
  "url": "https://pinabae-studio.vercel.app/jasa-pembuatan-website-sumbawa",
  "telephone": "+6282339265052",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Sumbawa Besar",
    "addressRegion": "Nusa Tenggara Barat",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -8.49858,
    "longitude": 117.43213
  },
  "description": "Digital Agency di Sumbawa yang melayani Jasa Pembuatan Website profesional untuk UMKM, Bisnis, dan Instansi.",
  "priceRange": "$$"
};

const combinedSchema = `[${JSON.stringify(localBusinessSchema)}, ${JSON.stringify(faqSchema)}]`;
---

<Layout 
  title="Jasa Pembuatan Website Sumbawa Profesional | Pinabae Studio" 
  description="Layanan Jasa Pembuatan Website di Sumbawa Besar oleh Pinabae Studio. Digital Agency & Web Developer tepercaya untuk website UMKM, Landing Page & SEO."
  schema={combinedSchema}
>
  <Navbar />
  
  <main class="flex-grow pt-24">
    <!-- Hero Section -->
    <Section class="py-16 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-orange-50 to-white -z-10"></div>
      
      <div class="max-w-7xl mx-auto">
        <Breadcrumb items={[{ label: "Jasa Pembuatan Website Sumbawa" }]} />
      </div>

      <div class="text-center max-w-4xl mx-auto hero-content opacity-0 translate-y-8 mt-8">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-border text-sm font-medium text-dark mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          DIGITAL AGENCY SUMBAWA
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-dark tracking-tight mb-8 text-balance leading-tight">
          Jasa Pembuatan Website <span class="text-orange-500">Sumbawa</span>
        </h1>
        <p class="text-lg md:text-xl text-text mb-12 text-balance leading-relaxed">
          Tingkatkan kredibilitas bisnis lokal Anda dengan website modern, cepat, dan SEO-friendly. Kami adalah web developer Sumbawa yang siap membantu UMKM, startup, dan instansi Anda.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="https://wa.me/6282339265052" size="md" target="Halo saya butuh jasa pembuatan website di Sumbawa">Konsultasi Gratis Sekarang</Button>
          <Button href="/portfolio" variant="outline" size="md">Lihat Portfolio Kami</Button>
        </div>
      </div>
    </Section>

    <!-- Penjelasan Layanan -->
    <Section class="py-20">
      <div class="text-center max-w-3xl mx-auto mb-16 section-header opacity-0">
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">Mengapa Bisnis Anda di Sumbawa Butuh Website?</h2>
        <p class="text-lg text-text leading-relaxed">Di era digital, pencarian lokal seperti "jasa bikin website sumbawa" atau "website umkm sumbawa" semakin meningkat. Website bukan hanya sekadar kartu nama online, tapi mesin pencetak prospek 24/7.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <Card hover={false} class="feature-item opacity-0 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Website UMKM & Bisnis</h3>
          <p class="text-text">Tingkatkan omset dan kepercayaan konsumen dengan profil perusahaan profesional yang bisa diakses kapan saja.</p>
        </Card>
        <Card hover={false} class="feature-item opacity-0 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <h3 class="text-xl font-bold mb-4">Landing Page Promosi</h3>
          <p class="text-text">Desain landing page Sumbawa yang khusus dibuat untuk konversi iklan dan penjualan produk Anda.</p>
        </Card>
        <Card hover={false} class="feature-item opacity-0 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-4">SEO & Digital Marketing</h3>
          <p class="text-text">Layanan SEO Sumbawa memastikan website Anda berada di halaman pertama Google saat dicari pelanggan lokal.</p>
        </Card>
      </div>
    </Section>

    <!-- Keunggulan Section -->
    <Section background="gray" class="py-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="section-header opacity-0">
          <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">Keunggulan Web Developer Sumbawa dari Pinabae Studio</h2>
          <p class="text-lg text-text mb-6">Sebagai digital agency yang memahami potensi lokal, kami memastikan website Anda tidak hanya bagus secara visual, tapi juga performa.</p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <div>
                <strong class="text-dark block">Desain Premium & Cepat</strong>
                <span class="text-text text-sm">Tidak lambat, mengutamakan pengalaman pengunjung.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <div>
                <strong class="text-dark block">Optimasi SEO On-Page</strong>
                <span class="text-text text-sm">Struktur data, schema, dan heading yang disukai Google.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 mt-1"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <div>
                <strong class="text-dark block">Harga Terjangkau untuk UMKM</strong>
                <span class="text-text text-sm">Solusi hemat tanpa mengurangi kualitas dan profesionalitas.</span>
              </div>
            </li>
          </ul>
        </div>
        <div class="feature-item opacity-0">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl">
            <img src="/logo.png" alt="Pinabae Studio Digital Agency Sumbawa Besar" class="w-full h-auto bg-white p-12 object-contain aspect-video" loading="lazy" />
          </div>
        </div>
      </div>
    </Section>

    <!-- Local FAQ Section -->
    <Section class="py-20">
      <div class="text-center max-w-2xl mx-auto mb-16 section-header opacity-0">
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-4">Pertanyaan Seputar Jasa Bikin Website Sumbawa</h2>
      </div>
      
      <div class="max-w-3xl mx-auto divide-y divide-gray-200">
        {faqs.map((faq, index) => (
          <div class="py-6 feature-item opacity-0">
            <h3 class="text-xl font-bold text-dark mb-3 flex items-start gap-3">
              <span class="text-orange-500 font-black">Q:</span> {faq.question}
            </h3>
            <p class="text-text text-lg pl-7">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </Section>

    <!-- CTA Section -->
    <Section class="py-24">
      <div class="max-w-4xl mx-auto cta-content opacity-0 translate-y-12 bg-orange-50 border border-orange-100 rounded-3xl p-10 md:p-16 text-center shadow-sm relative overflow-hidden">
        <div class="absolute -top-32 -right-32 w-64 h-64 bg-orange-400/20 blur-3xl rounded-full pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">Mulai Transformasi Digital Bisnis Anda di Sumbawa!</h2>
          <p class="text-lg text-text mb-10">Jangan biarkan kompetitor mengambil alih pasar lokal. Konsultasikan kebutuhan website Anda dengan Pinabae Studio sekarang.</p>
          <a href="https://wa.me/6282339265052" target="Halo, saya mau pesan website untuk area Sumbawa" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-orange-500 text-white rounded-full font-bold text-lg hover:bg-orange-600 transition-colors shadow-lg hover:shadow-xl hover:-translate-y-1">
            Hubungi Kami via WhatsApp
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </a>
        </div>
      </div>
    </Section>
  </main>
  
  <Footer />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  document.addEventListener('astro:page-load', () => {
    gsap.registerPlugin(ScrollTrigger);
    
    gsap.to('.hero-content', { opacity: 1, y: 0, duration: 1, ease: 'power3.out', delay: 0.2 });
    gsap.to('.feature-item', { scrollTrigger: { trigger: '.feature-item', start: 'top 85%' }, opacity: 1, y: 0, stagger: 0.15, duration: 0.8, ease: 'power2.out' });
    gsap.utils.toArray('.section-header').forEach((header: any) => {
      gsap.to(header, { scrollTrigger: { trigger: header, start: 'top 85%' }, opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' });
    });
    gsap.to('.cta-content', { scrollTrigger: { trigger: '.cta-content', start: 'top 85%' }, opacity: 1, y: 0, duration: 1, ease: 'power3.out' });
  });
</script>
