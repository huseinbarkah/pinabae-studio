        </Card>
        
        <Card hover={false} class="feature-item opacity-0 h-full flex flex-col items-center group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-orange-500/5 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-orange-500/10 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
