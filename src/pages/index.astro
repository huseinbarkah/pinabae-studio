<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  document.addEventListener('astro:page-load', () => {

gsap.registerPlugin(ScrollTrigger);
// Initial Hero Animation
    const heroTl = gsap.timeline({ delay: 0.2 });
    heroTl.to('.hero-text', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power3.out'
    })
    .to('.hero-badges', {
      opacity: 1,
      duration: 0.5,
      ease: 'power2.out'
    }, "-=0.4")
    .to('.hero-mockup', {
      opacity: 1,
      x: 0,
      duration: 0.8,
      ease: 'power3.out'
    }, "-=0.6")
    .to('.floating-card', {
      opacity: 1,
      scale: 1,
      duration: 0.6,
      stagger: 0.1,
      ease: 'back.out(1.5)'
    }, "-=0.4");
  
    // Features Animation
    gsap.to('.feature-item', {
      scrollTrigger: {
        trigger: '.feature-item',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // Section Headers Animation
    gsap.utils.toArray('.section-header').forEach((header: any) => {
      gsap.to(header, {
        scrollTrigger: {
          trigger: header,
          start: 'top 85%',
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out'
      });
    });
  
    // Cards Animation
    gsap.to('.service-card', {
      scrollTrigger: {
        trigger: '.service-card',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // Blog Header Animation
    gsap.to('.blog-header', {
      scrollTrigger: {
        trigger: '.blog-header',
        start: 'top 85%',
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // Blog Cards Animation
    gsap.to('.blog-card', {
      scrollTrigger: {
        trigger: '.blog-card',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // CTA Animation
    gsap.to('.cta-content', {
      scrollTrigger: {
        trigger: '.cta-content',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 1,
      ease: 'power3.out'
    });

  });
</script>
