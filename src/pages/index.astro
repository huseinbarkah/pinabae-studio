              Solusi Sesuai Kebutuhan Bisnis
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><path d="M20 6 9 17l-5-5"/></svg>
              Pendampingan Setelah Project Selesai
            </div>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="https://wa.me/6282339265052" target="Halo saya ingin menggunakan jasa pembuatan website Pinabae" rel="noopener noreferrer" class="group flex items-center justify-center gap-2 px-8 py-4 bg-[#F57C00] text-white rounded-full font-bold text-lg hover:bg-[#E65100] hover:scale-105 hover:-translate-y-1 hover:shadow-xl hover:shadow-orange-500/20 transition-all duration-300 w-full sm:w-auto">
              Konsultasi via WhatsApp
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="/jasa-pembuatan-website-sumbawa" class="flex items-center justify-center px-8 py-4 bg-white text-dark border border-gray-200 rounded-full font-bold text-lg hover:bg-gray-50 hover:scale-105 hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow w-full sm:w-auto">
              Layanan Website Sumbawa
            </a>
          </div>
        </div>
      </div>
    </Section>
	</main>

	<Footer />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  document.addEventListener('astro:page-load', () => {

gsap.registerPlugin(ScrollTrigger);
// Initial Hero Animation
    gsap.to('.hero-content', {
      opacity: 1,
      y: 0,
      duration: 1,
      ease: 'power3.out',
      delay: 0.2
    });
  
    // Features Animation
    gsap.to('.feature-item', {
      scrollTrigger: {
        trigger: '.feature-item',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      stagger: 0.1,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // Section Headers Animation
    gsap.utils.toArray('.section-header').forEach((header: any) => {
      gsap.to(header, {
        scrollTrigger: {
          trigger: header,
          start: 'top 85%',
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out'
      });
    });
  
    // Cards Animation
    gsap.to('.service-card', {
      scrollTrigger: {
        trigger: '.service-card',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // Blog Header Animation
    gsap.to('.blog-header', {
      scrollTrigger: {
        trigger: '.blog-header',
        start: 'top 85%',
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // Blog Cards Animation
    gsap.to('.blog-card', {
      scrollTrigger: {
        trigger: '.blog-card',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power2.out'
    });
  
    // CTA Animation
    gsap.to('.cta-content', {
      scrollTrigger: {
        trigger: '.cta-content',
        start: 'top 80%',
      },
      opacity: 1,
      y: 0,
      scale: 1,
      duration: 1,
      ease: 'power3.out'
    });

  });
</script>
