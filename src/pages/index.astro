---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import IntegrationMarquee from '../components/IntegrationMarquee.astro';
import { supabase } from '../lib/supabase';

let services = [];
let portfolio = [];
let faqs = [];
let posts = [];

try {
  const { data: servicesData } = await supabase.from('services').select('*').limit(3);
  if (servicesData) services = servicesData;
  
  const { data: portfolioData } = await supabase.from('portfolio').select('*').limit(4);
  if (portfolioData) portfolio = portfolioData;
  
  const { data: faqsData } = await supabase.from('faqs').select('*').limit(5);
  if (faqsData) faqs = faqsData;
  
  const { data: postsData } = await supabase
    .from('blog_posts')
    .select('*, categories(name, slug)')
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(3);
  if (postsData) posts = postsData;
} catch (error) {
  console.error('Supabase fetch error in index.astro:', error);
}
---

<Layout 
  title="Digital Agency Sumbawa | Jasa Pembuatan Website | Pinabae Studio"
  description="Pinabae Studio adalah Digital Agency dan Web Developer di Sumbawa yang melayani Jasa Pembuatan Website untuk UMKM, Bisnis, dan Instansi."
>
	<Navbar />
	
	<main class="flex-grow">
		<!-- Hero Section -->
		<Section class="min-h-screen flex items-center pt-32 pb-20 relative overflow-hidden bg-white">
      <!-- Background Gradients & Noise -->
      <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
        <!-- Radial Orange Top Left -->
        <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-[#FF7A00]/5 blur-3xl rounded-full"></div>
        <!-- Radial Blue Bottom Right -->
        <div class="absolute -bottom-40 -right-40 w-[600px] h-[600px] bg-blue-400/5 blur-3xl rounded-full"></div>
        <!-- Grid Pattern -->
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+PHBhdGggZD0iTTAgMGg0MHY0MEgweiIgZmlsbD0ibm9uZSIvPjxwYXRoIGQ9Ik0wIDAuNWg0ME0wLjUgMHY0MCIgc3Ryb2tlPSJyZ2JhKDAsMCwwLDAuMDIpIiBzdHJva2Utd2lkdGg9IjEiLz48L3N2Zz4=')] opacity-50"></div>
      </div>

			<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center relative z-10">
        <!-- Left Column -->
        <div class="lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left">
          <div class="hero-text opacity-0 translate-y-8">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-border text-xs font-bold text-dark mb-6 shadow-sm tracking-wide">
              <span class="w-2 h-2 rounded-full bg-[#FF7A00] animate-pulse"></span>
              DIGITAL AGENCY • SUMBAWA, NTB
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-extrabold text-dark tracking-tight mb-6 leading-[1.15]">
              Jasa Pembuatan <span class="text-[#FF7A00]">Website</span> & <span class="text-[#FF7A00]">Digital Agency</span> Sumbawa
            </h1>
            <p class="text-lg md:text-xl text-text mb-8 leading-relaxed max-w-2xl mx-auto lg:mx-0">
              Kami membantu UMKM, startup, dan perusahaan membangun kehadiran digital yang profesional melalui website, SEO, dan solusi digital yang meningkatkan kredibilitas, trafik, serta penjualan.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8 w-full sm:w-auto">
              <Button href="/jasa-pembuatan-website-sumbawa" size="md" class="hero-btn w-full sm:w-auto md:px-8 md:py-4 md:text-lg text-[#FF7A00] shadow-lg shadow-[#FF7A00]/20 hover:scale-105 transition-transform">Konsultasi Sekarang</Button>
              <Button href="/portfolio" variant="outline" size="md" class="hero-btn w-full sm:w-auto md:px-8 md:py-4 md:text-lg hover:bg-gray-50 hover:scale-105 transition-transform">Lihat Portfolio</Button>
            </div>
          </div>
        </div>
        
        <!-- Right Column (Visual) -->
        <div class="lg:col-span-7 relative flex justify-center items-center mt-16 lg:mt-0">
          <div class="relative w-full max-w-2xl hero-mockup opacity-0 translate-x-12">
            <!-- Mockup Image -->
            <Image src="/hero-mockup.png" alt="Premium Website Mockup" width={800} height={600} class="w-full h-auto drop-shadow-2xl hover:scale-[1.02] transition-transform duration-500 rounded-[2rem]" loading="eager" />
            
            <!-- Floating Cards -->
            <div class="absolute -left-4 md:-left-8 top-12 md:top-24 floating-card opacity-0 scale-90 px-4 py-3 bg-white/70 backdrop-blur-md border border-white/50 rounded-2xl shadow-xl flex items-center gap-3 hover:-translate-y-1.5 transition-transform cursor-default z-20">
              <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              </div>
              <div>
                <p class="text-sm font-extrabold text-dark leading-tight">SEO Ready</p>
                <p class="text-[10px] text-gray-500 font-medium">Tampil di Google</p>
              </div>
            </div>

            <div class="absolute -right-4 md:-right-6 top-1/4 md:top-1/3 floating-card opacity-0 scale-90 px-4 py-3 bg-white/70 backdrop-blur-md border border-white/50 rounded-2xl shadow-xl flex items-center gap-3 hover:-translate-y-1.5 transition-transform cursor-default z-20">
              <div class="w-10 h-10 rounded-full bg-orange-100 text-[#FF7A00] flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
              </div>
              <div>
                <p class="text-sm font-extrabold text-dark leading-tight">Fast Loading</p>
                <p class="text-[10px] text-gray-500 font-medium">Skor Core Web Vitals</p>
              </div>
            </div>

            <div class="absolute -left-2 md:left-4 bottom-1/4 md:bottom-1/3 floating-card opacity-0 scale-90 px-4 py-3 bg-white/70 backdrop-blur-md border border-white/50 rounded-2xl shadow-xl flex items-center gap-3 hover:-translate-y-1.5 transition-transform cursor-default z-20">
              <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
              </div>
              <div>
                <p class="text-sm font-extrabold text-dark leading-tight">WA Integration</p>
                <p class="text-[10px] text-gray-500 font-medium">Langsung ke Chat</p>
              </div>
            </div>

            <div class="absolute right-0 md:right-8 bottom-8 md:bottom-12 floating-card opacity-0 scale-90 px-4 py-3 bg-white/70 backdrop-blur-md border border-white/50 rounded-2xl shadow-xl flex items-center gap-3 hover:-translate-y-1.5 transition-transform cursor-default z-20">
              <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              </div>
              <div>
                <p class="text-sm font-extrabold text-dark leading-tight">Dashboard Admin</p>
                <p class="text-[10px] text-gray-500 font-medium">Kelola Web Sendiri</p>
              </div>
            </div>
          </div>
        </div>
			</div>
		</Section>

    <IntegrationMarquee />

    <!-- Trusted By / Features -->
    <Section background="gray" class="py-20">
      <div class="text-center max-w-3xl mx-auto mb-16 section-header opacity-0">
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">Mengapa Bisnis Memilih Pinabae Studio?</h2>
        <p class="text-lg text-text leading-relaxed">Kami menggabungkan strategi, desain, dan teknologi untuk menciptakan solusi digital yang relevan, berdampak, dan mendukung pertumbuhan bisnis.</p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        <Card hover={false} class="feature-item opacity-0 h-full flex flex-col items-center group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-orange-500/5 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-orange-500/10 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Strategi Berbasis Tujuan</h3>
          <p class="text-text leading-[1.7] flex-grow">Kami memulai setiap proyek dengan memahami tujuan bisnis Anda agar solusi digital yang dibangun benar-benar memberikan nilai dan hasil yang terukur.</p>
        </Card>
        
        <Card hover={false} class="feature-item opacity-0 h-full flex flex-col items-center group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-orange-500/5 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-orange-500/10 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Solusi Digital Terintegrasi</h3>
          <p class="text-text leading-[1.7] flex-grow">Website, SEO, branding, dan solusi digital kami dirancang saling terhubung untuk memperkuat kehadiran bisnis Anda di dunia digital.</p>
        </Card>

        <Card hover={false} class="feature-item opacity-0 h-full flex flex-col items-center group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-orange-500/5 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-orange-500/10 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Berorientasi pada Pertumbuhan</h3>
          <p class="text-text leading-[1.7] flex-grow">Setiap solusi yang kami bangun difokuskan untuk meningkatkan visibilitas, membangun kepercayaan pelanggan, dan membuka lebih banyak peluang bisnis.</p>
        </Card>

        <Card hover={false} class="feature-item opacity-0 h-full flex flex-col items-center group hover:-translate-y-1.5 hover:shadow-xl hover:shadow-orange-500/5 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-orange-500/10 flex items-center justify-center mb-6 group-hover:scale-105 transition-transform duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="m11 17 2 2a1 1 0 1 0 3-3"/><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3-6 6"/><path d="m15 15 7.82-7.82a2 2 0 0 0 0-2.83l-1.34-1.34a2 2 0 0 0-2.83 0L3 18.83a2 2 0 0 0 0 2.83l1.34 1.34a2 2 0 0 0 2.83 0L15 15Z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-4">Kolaborasi yang Transparan</h3>
          <p class="text-text leading-[1.7] flex-grow">Kami mengutamakan komunikasi yang terbuka, proses kerja yang jelas, dan pendampingan yang responsif agar setiap proyek berjalan efektif.</p>
        </Card>
      </div>
    </Section>

    <!-- Services Section -->
    <Section>
      <div class="text-center max-w-2xl mx-auto mb-16 section-header opacity-0">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">Solusi Digital untuk Mengembangkan Bisnis Anda</h2>
        <p class="text-lg text-text">Kami membantu UMKM, perusahaan, hingga personal brand membangun kehadiran digital yang profesional, dipercaya pelanggan, dan siap mendukung pertumbuhan bisnis.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services && services.length > 0 ? (
          services.map((service: any) => (
            <Card class="service-card opacity-0 flex flex-col h-full">
              <div class="w-12 h-12 bg-orange-100 text-primary rounded-xl flex items-center justify-center mb-6">
                <i data-lucide={service.icon || "box"} class="w-6 h-6"></i>
              </div>
              <h3 class="text-2xl font-bold mb-4">{service.title}</h3>
              <p class="text-text mb-6 line-clamp-3 flex-grow">{service.description.replace(/<[^>]*>?/gm, '')}</p>
              <a href={`/layanan`} class="text-primary font-medium hover:underline flex items-center gap-2 mt-auto">
                Selengkapnya
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </Card>
          ))
        ) : (
          [1, 2, 3].map(() => (
            <Card class="service-card opacity-0 flex flex-col h-full">
              <div class="w-12 h-12 bg-orange-100 text-primary rounded-xl flex items-center justify-center mb-6">
                <i data-lucide="box" class="w-6 h-6"></i>
              </div>
              <h3 class="text-2xl font-bold mb-4">Company Profile</h3>
              <p class="text-text mb-6 flex-grow">Bangun kredibilitas bisnis Anda dengan website profil perusahaan yang profesional dan meyakinkan.</p>
              <a href="/layanan" class="text-primary font-medium hover:underline flex items-center gap-2 mt-auto">
                Pelajari Lebih Lanjut
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </Card>
          ))
        )}
      </div>
    </Section>

    <!-- Blog Preview Section -->
    <Section class="py-24 relative overflow-hidden bg-white border-t border-border/50">
      <!-- Soft Orange Blur Decoration -->
      <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-orange-400/5 blur-3xl rounded-full pointer-events-none"></div>

      <div class="relative z-10 max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 blog-header opacity-0 translate-y-8">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-50 text-orange-600 text-sm font-semibold mb-6 border border-orange-100">
              INSIGHT DIGITAL
            </div>
            <h2 class="text-4xl md:text-5xl font-extrabold text-dark tracking-tight mb-6 leading-tight">
              Artikel & Insight untuk Mengembangkan Bisnis Digital.
            </h2>
            <p class="text-lg text-text">
              Temukan berbagai artikel seputar website, SEO, branding, teknologi, dan strategi digital untuk membantu bisnis Anda berkembang.
            </p>
          </div>
          <a href="/blog" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-white text-dark border border-gray-200 rounded-full font-semibold hover:bg-gray-50 hover:shadow-sm transition-all whitespace-nowrap mb-2">
            Lihat Semua Artikel
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {posts && posts.length > 0 ? (
            posts.map((post: any) => (
              <a href={`/blog/${post.slug}`} class="group block blog-card opacity-0 translate-y-12 h-full">
                <div class="bg-white rounded-[24px] border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl hover:shadow-orange-500/5 transition-all duration-500 hover:-translate-y-2 flex flex-col h-full">
                  <div class="relative h-60 overflow-hidden bg-gray-100">
                    {post.featured_image ? (
                      <Image src={post.featured_image} alt={post.title || "Blog Post"} width={800} height={500} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-gray-400">No Image</div>
                    )}
                    {post.categories && (
                      <div class="absolute top-4 left-4">
                        <span class="px-3 py-1.5 bg-white/90 backdrop-blur-md text-dark text-xs font-bold rounded-full shadow-sm">{post.categories.name}</span>
                      </div>
                    )}
                  </div>
                  <div class="p-6 md:p-8 flex-grow flex flex-col">
                    <h3 class="text-xl md:text-2xl font-bold text-dark mb-4 leading-snug group-hover:text-orange-500 transition-colors">
                      {post.title}
                    </h3>
                    <p class="text-text mb-8 line-clamp-2 flex-grow">
                      {post.excerpt}
                    </p>
                    <div class="flex items-center justify-between text-sm text-gray-500 font-medium pt-5 border-t border-gray-100 mt-auto">
                      <span>{post.published_at ? new Date(post.published_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Unknown Date'}</span>
                      <span class="flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 
                        Baca Artikel
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            ))
          ) : (
            [1, 2, 3].map(() => (
              <div class="group block blog-card opacity-0 translate-y-12 h-full">
                <div class="bg-white rounded-[24px] border border-gray-200 overflow-hidden shadow-sm flex flex-col h-full">
                  <div class="relative h-60 overflow-hidden bg-gray-100 animate-pulse"></div>
                  <div class="p-6 md:p-8 flex-grow flex flex-col">
                    <div class="h-6 bg-gray-200 rounded w-3/4 mb-4 animate-pulse"></div>
                    <div class="h-4 bg-gray-200 rounded w-full mb-2 animate-pulse"></div>
                    <div class="h-4 bg-gray-200 rounded w-5/6 mb-8 animate-pulse"></div>
                    <div class="flex items-center justify-between mt-auto">
                      <div class="h-4 bg-gray-200 rounded w-1/4 animate-pulse"></div>
                      <div class="h-4 bg-gray-200 rounded w-1/4 animate-pulse"></div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
      </div>
    </Section>

    <div class="h-px bg-gradient-to-r from-transparent via-gray-200 to-transparent max-w-7xl mx-auto my-4"></div>

    <!-- CTA Section -->
    <Section class="py-24">
      <div class="max-w-5xl mx-auto cta-content opacity-0 translate-y-12 scale-95 relative overflow-hidden bg-[#F8FAFC] border border-gray-200 rounded-[32px] p-10 md:p-16 lg:p-20 text-center shadow-sm">
        <!-- Soft Orange Blur Decoration -->
        <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-orange-400/10 blur-3xl rounded-full pointer-events-none"></div>

        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 text-sm font-semibold text-dark mb-8 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
            Konsultasi Gratis
          </div>
          
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-dark tracking-tight mb-8 text-balance leading-tight">
            Siap Mengembangkan Bisnis Anda  <br class="hidden md:block"/> Secara Digital?
          </h2>
          
          <p class="text-lg md:text-xl text-text mb-12 text-balance leading-relaxed max-w-3xl mx-auto">
            Konsultasikan kebutuhan digital bisnis Anda bersama Pinabae Studio. Kami membantu merancang solusi yang tepat untuk meningkatkan kredibilitas, visibilitas, dan peluang pertumbuhan bisnis Anda.
          </p>

          <div class="flex flex-wrap justify-center items-center gap-4 md:gap-8 mb-14 text-sm md:text-base font-semibold text-dark">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><path d="M20 6 9 17l-5-5"/></svg>
              Konsultasi Gratis
            </div>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><path d="M20 6 9 17l-5-5"/></svg>
              Harga Transparan
