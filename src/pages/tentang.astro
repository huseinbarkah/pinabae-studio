---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { supabase } from '../lib/supabase';

let teamMembers = [];
try {
  const { data } = await supabase
    .from('team_members')
    .select('*')
    .order('created_at', { ascending: true });
  if (data) teamMembers = data;
} catch (error) {
  console.error('Supabase error on team:', error);
}
---

<Layout title="Tentang Kami | Digital Agency Sumbawa - Pinabae Studio" description="Pinabae Studio adalah Digital Agency dan Web Developer di Sumbawa yang membantu bisnis lokal dan UMKM membangun kehadiran digital profesional.">
  <Navbar />
  
  <main class="flex-grow pt-32">
    <!-- SECTION 1 — Hero About -->
    <Section class="pb-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-orange-50/60 rounded-full blur-3xl -z-10 translate-x-1/3 -translate-y-1/4 pointer-events-none"></div>
      
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
        <div class="lg:w-1/2 hero-anim opacity-0 translate-y-8">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-orange-50 border border-orange-100 rounded-full text-sm text-primary font-bold mb-6 mt-4">
            <i data-lucide="map-pin" class="w-4 h-4"></i>
            Digital Agency • Sumbawa, NTB
          </div>
          
          <Breadcrumb items={[{ label: "Tentang Kami" }]} />

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-dark tracking-tight mb-6 leading-[1.15] mt-4">
            Digital Agency Sumbawa yang Membantu Bisnis Bertumbuh
          </h1>
          <p class="text-lg md:text-xl text-text leading-relaxed mb-10 text-balance">
            Pinabae Studio adalah digital agency asal Sumbawa yang membantu UMKM, perusahaan, startup, dan personal brand membangun kehadiran digital yang profesional. Kami percaya bahwa platform bisnis bukan sekadar identitas online, tetapi aset digital yang mampu meningkatkan kepercayaan, memperluas jangkauan pelanggan, dan mendorong pertumbuhan bisnis.
          </p>
         
        </div>
        
        <div class="lg:w-1/2 w-full hero-anim opacity-0 translate-y-8 delay-100 relative">
          <!-- Website Mockup Illustration -->
          <div class="relative w-full aspect-[4/3] bg-white rounded-2xl shadow-[0_20px_60px_-15px_rgba(249,115,22,0.15)] border border-gray-100 overflow-hidden flex flex-col">
            <div class="h-10 border-b border-gray-100 bg-gray-50/50 flex items-center px-4 gap-2 shrink-0">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
            </div>
            <div class="flex-grow p-6 md:p-8 bg-gray-50 relative overflow-hidden">
              <div class="w-full h-32 md:h-40 bg-orange-100/50 rounded-xl mb-5"></div>
              <div class="w-3/4 h-6 bg-gray-200 rounded-md mb-3"></div>
              <div class="w-1/2 h-6 bg-gray-200 rounded-md mb-8"></div>
              <div class="grid grid-cols-2 gap-4">
                <div class="h-24 bg-white rounded-xl shadow-sm"></div>
                <div class="h-24 bg-white rounded-xl shadow-sm"></div>
              </div>
              
            </div>
          </div>
        </div>
      </div>
    </Section>

    <!-- SECTION 2 — Cerita di Balik Pinabae -->
    <Section background="gray" class="py-24 text-center">
      <div class="max-w-3xl mx-auto fade-up-anim opacity-0 translate-y-8">
        <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-8 shadow-sm text-primary">
          <i data-lucide="sparkles" class="w-8 h-8"></i>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">Cerita di Balik Nama Pinabae</h2>
        <p class="text-lg md:text-xl text-text leading-relaxed text-balance">
          <strong>Pinabae</strong> berasal dari bahasa Sumbawa yang berarti <em>"Buat Saja"</em>. Filosofi ini menjadi semangat kami bahwa membangun solusi digital tidak perlu rumit. Kami membantu bisnis berkembang melalui platform yang modern, cepat, dan dirancang sesuai kebutuhan tanpa proses yang berbelit-belit.
        </p>
      </div>
    </Section>

    <!-- SECTION 3 — Visi & Misi -->
    <Section class="py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <Card hover={false} class="p-10 md:p-12 fade-up-anim opacity-0 translate-y-8 flex flex-col items-start border-gray-200">
          <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center text-primary mb-8">
            <i data-lucide="target" class="w-8 h-8"></i>
          </div>
          <h3 class="text-3xl font-bold text-dark mb-6 tracking-tight">Visi</h3>
          <p class="text-lg text-text leading-relaxed flex-grow">
            Menjadi digital agency terpercaya di Sumbawa yang membantu bisnis lokal berkembang melalui solusi digital yang efektif, modern, dan berorientasi pada hasil.
          </p>
        </Card>
        
        <Card hover={false} class="p-10 md:p-12 fade-up-anim opacity-0 translate-y-8 flex flex-col items-start border-gray-200 bg-dark text-white border-none shadow-xl shadow-gray-900/10">
          <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center text-primary mb-8">
            <i data-lucide="flag" class="w-8 h-8"></i>
          </div>
          <h3 class="text-3xl font-bold mb-6 text-dark tracking-tight">Misi</h3>
          <ul class="text-lg text-dark leading-relaxed space-y-5 flex-grow">
            <li class="flex items-start gap-4">
              <i data-lucide="check-circle-2" class="w-6 h-6 text-primary shrink-0 mt-0.5"></i>
              <span>Membantu UMKM memiliki identitas digital profesional.</span>
            </li>
            <li class="flex items-start gap-4">
              <i data-lucide="check-circle-2" class="w-6 h-6 text-primary shrink-0 mt-0.5"></i>
              <span>Mengembangkan aset digital yang cepat, modern, dan SEO Friendly.</span>
            </li>
            <li class="flex items-start gap-4">
              <i data-lucide="check-circle-2" class="w-6 h-6 text-primary shrink-0 mt-0.5"></i>
              <span>Memberikan pelayanan yang transparan dan mudah dipahami.</span>
            </li>
            <li class="flex items-start gap-4">
              <i data-lucide="check-circle-2" class="w-6 h-6 text-primary shrink-0 mt-0.5"></i>
              <span>Menjadi partner digital jangka panjang bagi setiap klien.</span>
            </li>
          </ul>
        </Card>
      </div>
    </Section>

    <!-- SECTION 4 — Nilai yang Kami Pegang -->
    <Section class="py-24 bg-[#F8FAFC]">
      <div class="text-center max-w-3xl mx-auto mb-16 fade-up-anim opacity-0 translate-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-dark tracking-tight mb-6">Nilai yang Kami Pegang</h2>
        <p class="text-lg text-text">Prinsip utama yang menjadi landasan kami dalam memberikan solusi digital terbaik untuk setiap klien.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
        <Card hover={false} class="p-8 lg:p-10 fade-up-anim opacity-0 translate-y-8 group transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center text-primary mb-6 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
            <i data-lucide="lightbulb" class="w-8 h-8"></i>
          </div>
          <h3 class="text-2xl font-bold text-dark mb-4 tracking-tight">Berorientasi pada Solusi</h3>
          <p class="text-text leading-relaxed">
            Kami memahami kebutuhan bisnis terlebih dahulu sebelum menentukan strategi digital yang tepat sasaran.
          </p>
        </Card>
        
        <Card hover={false} class="p-8 lg:p-10 fade-up-anim opacity-0 translate-y-8 group transition-all duration-300 hover:shadow-xl hover:-translate-y-1 delay-75">
          <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center text-primary mb-6 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
            <i data-lucide="handshake" class="w-8 h-8"></i>
          </div>
          <h3 class="text-2xl font-bold text-dark mb-4 tracking-tight">Kolaborasi</h3>
          <p class="text-text leading-relaxed">
            Kami percaya komunikasi yang baik dan kolaborasi erat menghasilkan platform yang sejalan dengan tujuan bisnis.
          </p>
        </Card>

        <Card hover={false} class="p-8 lg:p-10 fade-up-anim opacity-0 translate-y-8 group transition-all duration-300 hover:shadow-xl hover:-translate-y-1 delay-100">
          <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center text-primary mb-6 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
            <i data-lucide="shield-check" class="w-8 h-8"></i>
          </div>
          <h3 class="text-2xl font-bold text-dark mb-4 tracking-tight">Transparansi</h3>
          <p class="text-text leading-relaxed">
            Mulai dari konsultasi, proses pengerjaan, hingga revisi dilakukan secara terbuka tanpa adanya biaya tersembunyi.
          </p>
        </Card>

        <Card hover={false} class="p-8 lg:p-10 fade-up-anim opacity-0 translate-y-8 group transition-all duration-300 hover:shadow-xl hover:-translate-y-1 delay-150">
          <div class="w-16 h-16 bg-orange-50 rounded-2xl flex items-center justify-center text-primary mb-6 group-hover:scale-110 group-hover:bg-orange-100 transition-all duration-300">
            <i data-lucide="trending-up" class="w-8 h-8"></i>
          </div>
          <h3 class="text-2xl font-bold text-dark mb-4 tracking-tight">Fokus pada Pertumbuhan</h3>
          <p class="text-text leading-relaxed">
            Target kami bukan sekadar menyelesaikan proyek, tetapi membantu bisnis memperoleh lebih banyak peluang melalui pengalaman digital.
          </p>
        </Card>
      </div>
    </Section>

    <!-- SECTION 5 — Cara Kami Bekerja -->
    <Section class="py-24 overflow-hidden">
      <div class="text-center max-w-3xl mx-auto mb-20 fade-up-anim opacity-0 translate-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-dark tracking-tight mb-6">Cara Kami Bekerja</h2>
        <p class="text-lg text-text">Proses sistematis yang kami terapkan untuk memastikan hasil yang optimal, tepat waktu, dan berdampak nyata bagi bisnis Anda.</p>
      </div>

      <div class="relative max-w-6xl mx-auto">
        <!-- Horizontal Line for Desktop / Tablet -->
        <div class="hidden md:block absolute top-[44px] left-[8%] right-[8%] h-0.5 bg-gray-200 -z-10"></div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-10 lg:gap-6">
          <!-- Step 1 -->
          <div class="flex flex-col items-center text-center fade-up-anim opacity-0 translate-y-8">
            <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.08)] flex items-center justify-center text-primary mb-6 relative z-10 hover:scale-110 hover:text-orange-600 transition-all duration-300">
              <i data-lucide="message-circle" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-dark mb-3">1. Konsultasi</h3>
            <p class="text-sm text-text leading-relaxed">Kami memahami bisnis dan kebutuhan Anda secara mendalam.</p>
          </div>
          
          <!-- Step 2 -->
          <div class="flex flex-col items-center text-center fade-up-anim opacity-0 translate-y-8 delay-75">
            <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.08)] flex items-center justify-center text-primary mb-6 relative z-10 hover:scale-110 hover:text-orange-600 transition-all duration-300">
              <i data-lucide="clipboard-list" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-dark mb-3">2. Perencanaan</h3>
            <p class="text-sm text-text leading-relaxed">Menentukan strategi, struktur digital, dan fitur yang dibutuhkan.</p>
          </div>

          <!-- Step 3 -->
          <div class="flex flex-col items-center text-center fade-up-anim opacity-0 translate-y-8 delay-100">
            <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.08)] flex items-center justify-center text-primary mb-6 relative z-10 hover:scale-110 hover:text-orange-600 transition-all duration-300">
              <i data-lucide="pen-tool" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-dark mb-3">3. Desain</h3>
            <p class="text-sm text-text leading-relaxed">Mendesain tampilan yang modern, bersih, dan mudah digunakan.</p>
          </div>

          <!-- Step 4 -->
          <div class="flex flex-col items-center text-center fade-up-anim opacity-0 translate-y-8 delay-150">
            <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.08)] flex items-center justify-center text-primary mb-6 relative z-10 hover:scale-110 hover:text-orange-600 transition-all duration-300">
              <i data-lucide="code-2" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-dark mb-3">4. Development</h3>
            <p class="text-sm text-text leading-relaxed">Membangun platform menggunakan teknologi modern berkinerja tinggi.</p>
          </div>

          <!-- Step 5 -->
          <div class="flex flex-col items-center text-center fade-up-anim opacity-0 translate-y-8 delay-200">
            <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.08)] flex items-center justify-center text-primary mb-6 relative z-10 hover:scale-110 hover:text-orange-600 transition-all duration-300">
              <i data-lucide="rocket" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-dark mb-3">5. Launch</h3>
            <p class="text-sm text-text leading-relaxed">Platform dipublikasikan secara resmi dan siap menyapa dunia.</p>
          </div>

          <!-- Step 6 -->
          <div class="flex flex-col items-center text-center fade-up-anim opacity-0 translate-y-8 delay-300">
            <div class="w-24 h-24 bg-white rounded-full border-[6px] border-white shadow-[0_8px_30px_rgb(0,0,0,0.08)] flex items-center justify-center text-primary mb-6 relative z-10 hover:scale-110 hover:text-orange-600 transition-all duration-300">
              <i data-lucide="life-buoy" class="w-8 h-8"></i>
            </div>
            <h3 class="text-lg font-bold text-dark mb-3">6. Support</h3>
            <p class="text-sm text-text leading-relaxed">Kami tetap memberikan bantuan penuh setelah proyek selesai.</p>
          </div>
        </div>
      </div>
    </Section>

    <!-- SECTION 6 — Tim Kami -->
    <Section class="py-24 bg-[#F8FAFC]">
      <div class="text-center max-w-3xl mx-auto mb-16 fade-up-anim opacity-0 translate-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-dark tracking-tight mb-6">Tim Kami</h2>
        <p class="text-lg text-text">Orang-orang di balik Pinabae Studio yang berkomitmen menghadirkan solusi digital terbaik untuk membantu bisnis bertumbuh.</p>
      </div>

      <div class={`grid gap-5 md:gap-6 mx-auto px-4 sm:px-0 ${
        teamMembers.length === 1 ? 'grid-cols-1 max-w-[260px] sm:max-w-xs' :
        teamMembers.length === 2 ? 'grid-cols-1 sm:grid-cols-2 max-w-xl' :
        'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 max-w-5xl'
      } team-grid`}>
        {teamMembers && teamMembers.length > 0 ? (
          teamMembers.map((member: any) => (
            <div class="team-card opacity-0 translate-y-10 h-full">
              <div class="group h-full bg-white rounded-2xl p-3 sm:p-4 border border-gray-100 shadow-sm transition-all duration-500 ease-out hover:-translate-y-1.5 hover:border-orange-500 hover:shadow-2xl hover:shadow-orange-900/10 flex flex-col items-center text-center overflow-hidden">
                
                <div class="w-full aspect-[4/5] rounded-xl bg-gray-100 mb-5 overflow-hidden relative">
                  {member.photo_url ? (
                    <Image src={member.photo_url} alt={member.name} width={400} height={500} class="w-full h-full object-cover grayscale opacity-85 transition-all duration-500 ease-out group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-[1.03]" loading="lazy" decoding="async" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                      <i data-lucide="user" class="w-16 h-16"></i>
                    </div>
                  )}
                </div>

                <div class="flex flex-col flex-grow w-full px-1">
                  <h3 class="text-lg font-bold text-dark mb-1 group-hover:text-primary transition-colors duration-300 tracking-tight">{member.name}</h3>
                  <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-3">{member.position}</p>
                  
                  {member.biography && (
                    <p class="text-sm text-text leading-relaxed flex-grow mb-5">
                      {member.biography}
                    </p>
                  )}
                  
                  <div class="mt-auto flex justify-center gap-3 pt-4 border-t border-gray-100 w-full">
                    <a href={member.instagram_url || "#"} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-400 hover:text-primary transition-colors duration-300 p-1 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                    </a>
                    <a href={member.linkedin_url || "#"} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-gray-400 hover:text-primary transition-colors duration-300 p-1 flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                    {member.github_url && (
                      <a href={member.github_url} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-gray-400 hover:text-primary transition-colors duration-300 p-1 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                      </a>
                    )}
                    {member.website_url && (
                      <a href={member.website_url} target="_blank" rel="noopener noreferrer" aria-label="Website" class="text-gray-400 hover:text-primary transition-colors duration-300 p-1 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        ) : (
          <div class="col-span-full flex flex-col items-center justify-center py-16 text-center">
            <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center text-gray-300 mb-6">
              <i data-lucide="users" class="w-10 h-10"></i>
            </div>
            <h3 class="text-xl font-bold text-dark mb-2">Belum ada anggota tim</h3>
            <p class="text-text">Belum ada anggota tim yang ditampilkan saat ini.</p>
          </div>
        )}
      </div>
    </Section>

    <!-- SECTION 7 — Perjalanan Pinabae Studio -->
    <Section class="py-24 bg-[#F8FAFC]">
      <div class="text-center max-w-3xl mx-auto mb-20 fade-up-anim opacity-0 translate-y-8">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-dark tracking-tight mb-6">Perjalanan Pinabae Studio</h2>
        <p class="text-lg text-text">Langkah demi langkah kami membangun dan berkembang bersama klien.</p>
      </div>

      <div class="max-w-2xl mx-auto relative px-4 sm:px-0">
        <!-- Vertical Line -->
        <div class="absolute left-[39px] md:left-1/2 top-0 bottom-0 w-1 bg-orange-100 md:-translate-x-1/2 rounded-full"></div>

        <div class="space-y-12">
          <!-- Item 1 -->
          <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between group fade-up-anim opacity-0 translate-y-8">
            <div class="hidden md:block w-[45%] text-right pr-12">
              <h3 class="text-3xl font-extrabold text-dark tracking-tight">2026</h3>
            </div>
            <div class="absolute left-0 md:left-1/2 w-[22px] h-[22px] ml-[11px] md:ml-0 bg-white border-4 border-primary rounded-full z-10 md:-translate-x-1/2 group-hover:scale-125 transition-transform duration-300 shadow-sm mt-3 md:mt-0">
            </div>
            <div class="pl-20 md:pl-12 md:w-[45%]">
              <h3 class="text-2xl md:hidden font-extrabold text-dark mb-3">2026</h3>
              <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 group-hover:shadow-md transition-all">
                <p class="text-lg text-text font-medium">Pinabae Studio resmi didirikan.</p>
              </div>
            </div>
          </div>
          
          <!-- Item 2 -->
          <div class="relative flex flex-col md:flex-row items-start md:items-center justify-between group fade-up-anim opacity-0 translate-y-8">
            <div class="hidden md:block w-[45%] text-right pr-12">
