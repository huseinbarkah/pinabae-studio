<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  document.addEventListener('astro:page-load', () => {

gsap.registerPlugin(ScrollTrigger);
// Animate hero elements on load
    gsap.to('.hero-anim', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.2,
      ease: 'power3.out',
      delay: 0.1
    });
  
    // Animate team cards on scroll
    gsap.utils.toArray('.team-grid').forEach((grid: any) => {
      gsap.to(grid.querySelectorAll('.team-card'), {
        scrollTrigger: {
          trigger: grid,
          start: 'top 85%',
          once: true
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: 'power3.out'
      });
    });
  
    // Animate fade-up elements on scroll
    gsap.utils.toArray('.fade-up-anim').forEach((el: any) => {
      gsap.to(el, {
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          once: true
        },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power3.out'
      });
    });

  });
</script>
