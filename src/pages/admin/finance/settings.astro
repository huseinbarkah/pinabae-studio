---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase } from '../../../lib/supabase';

// Pre-fetch settings for SSR
let initialSettings = null;
try {
  const { data } = await supabase.from('financial_settings').select('*').limit(1).single();
  if (data) initialSettings = data;
} catch (e) {
  console.error("Error fetching financial settings:", e);
}
---

<AdminLayout title="Pengaturan Keuangan | Admin Pinabae">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-dark">Pengaturan Keuangan</h1>
    <p class="text-text">Kelola preferensi invoice, target, dan profil bisnis.</p>
  </div>

  <div x-data="financeSettings()" class="bg-white rounded-xl border border-border shadow-sm overflow-hidden mb-12">
    <div class="p-6 border-b border-border bg-gray-50 flex justify-between items-center">
      <h2 class="text-lg font-bold text-dark flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l-.43-.25a2 2 0 0 1-1 1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        Preferensi Modul
      </h2>
      <button @click="saveSettings" class="px-5 py-2 bg-primary text-white rounded-lg font-bold hover:bg-orange-600 transition-colors flex items-center gap-2 shadow-sm shadow-orange-500/20" :disabled="loading">
        <span x-show="!loading">Simpan Perubahan</span>
        <span x-show="loading" style="display: none;" class="flex items-center gap-2">
          <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          Menyimpan...
        </span>
      </button>
    </div>

    <!-- Toast Notification -->
    <div x-show="toast.show" x-transition.opacity.duration.300ms style="display: none;" class="absolute top-6 right-6 z-50 rounded-lg p-4 shadow-lg flex items-center gap-3" :class="toast.type === 'success' ? 'bg-green-50 text-green-800 border border-green-200' : 'bg-red-50 text-red-800 border border-red-200'">
      <svg x-show="toast.type === 'success'" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
      <svg x-show="toast.type === 'error'" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
      <span class="font-medium text-sm" x-text="toast.message"></span>
    </div>

    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
      <!-- Section 1: Profil Bisnis -->
      <div class="md:col-span-2 border-b border-gray-100 pb-2 mb-2">
        <h3 class="font-bold text-dark text-sm uppercase tracking-wider">Profil Bisnis (Untuk Invoice)</h3>
      </div>
      
      <div>
        <label class="block text-sm font-bold text-dark mb-2">Nama Bisnis</label>
        <input type="text" x-model="settings.business_name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
      </div>
      
      <div>
        <label class="block text-sm font-bold text-dark mb-2">Mata Uang Default</label>
        <input type="text" x-model="settings.currency" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Contoh: IDR, USD">
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-bold text-dark mb-2">Alamat Lengkap</label>
        <textarea x-model="settings.address" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Alamat perusahaan..."></textarea>
      </div>

      <div>
        <label class="block text-sm font-bold text-dark mb-2">Informasi Rekening Bank</label>
        <textarea x-model="settings.bank_account" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="BCA: 12345678 a/n Pinabae"></textarea>
        <p class="text-xs text-gray-500 mt-1">Ditampilkan di bagian bawah invoice.</p>
      </div>

      <div>
        <label class="block text-sm font-bold text-dark mb-2">Link Logo URL</label>
        <input type="text" x-model="settings.logo_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="https://...">
        <p class="text-xs text-gray-500 mt-1">Gunakan URL absolut untuk logo di invoice PDF.</p>
      </div>

      <!-- Section 2: Preferensi Keuangan -->
      <div class="md:col-span-2 border-b border-gray-100 pb-2 mb-2 mt-4">
        <h3 class="font-bold text-dark text-sm uppercase tracking-wider">Preferensi Sistem</h3>
      </div>

      <div>
        <label class="block text-sm font-bold text-dark mb-2">Prefix Nomor Invoice</label>
        <input type="text" x-model="settings.invoice_prefix" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="INV-">
      </div>

      <div>
        <label class="block text-sm font-bold text-dark mb-2">Persentase Pajak Default (%)</label>
        <input type="number" step="0.1" x-model="settings.tax_percentage" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
      </div>

      <div>
        <label class="block text-sm font-bold text-dark mb-2">Target Pendapatan Bulanan</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-medium">Rp</span>
          <input type="number" x-model="settings.monthly_target" class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
        </div>
        <p class="text-xs text-gray-500 mt-1">Untuk progress bar di Dashboard Keuangan.</p>
      </div>
      
      <div>
        <label class="block text-sm font-bold text-dark mb-2">Link QRIS (Opsional)</label>
        <input type="text" x-model="settings.qris_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="https://...">
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ initialSettings }}>
  window.__INITIAL_FINANCE_SETTINGS__ = initialSettings;
</script>

<script>
  import { supabase } from '../../../lib/supabase';

  document.addEventListener('alpine:init', () => {
    window.Alpine.data('financeSettings', () => ({
      loading: false,
      toast: { show: false, message: '', type: 'success' },
      settings: window.__INITIAL_FINANCE_SETTINGS__ || {
        business_name: 'Pinabae Studio',
        address: '',
        logo_url: '',
        bank_account: '',
        qris_url: '',
        currency: 'IDR',
        tax_percentage: 0,
        invoice_prefix: 'INV-',
        monthly_target: 10000000
      },

      showToast(msg, type = 'success') {
        this.toast.message = msg;
        this.toast.type = type;
        this.toast.show = true;
        setTimeout(() => this.toast.show = false, 3000);
      },

      async saveSettings() {
        this.loading = true;
        try {
          let error;
          
          if (this.settings.id) {
            // Update
            const { error: updateError } = await supabase
              .from('financial_settings')
              .update(this.settings)
              .eq('id', this.settings.id);
            error = updateError;
          } else {
            // Insert
            const { data, error: insertError } = await supabase
              .from('financial_settings')
              .insert([this.settings])
              .select()
              .single();
            error = insertError;
            if (data) this.settings = data;
          }

          if (error) throw error;
          this.showToast('Pengaturan berhasil disimpan!');
        } catch (err) {
          console.error("Error saving settings:", err);
          this.showToast('Gagal menyimpan: ' + (err.message || 'Unknown error'), 'error');
        } finally {
          this.loading = false;
        }
      }
    }));
  });
</script>
