---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Kelola Klien | Modul Keuangan">
  <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
    <div>
      <h1 class="text-2xl font-bold text-dark">Manajemen Klien</h1>
      <p class="text-text">Kelola data klien, status project, dan tagihan.</p>
    </div>
    <div class="flex items-center gap-3">
      <button onclick="document.dispatchEvent(new CustomEvent('export-clients-csv'))" class="px-4 py-2 bg-white text-dark border border-gray-300 rounded-lg font-bold hover:bg-gray-50 transition-colors flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        Export CSV
      </button>
      <button onclick="document.dispatchEvent(new CustomEvent('open-client-modal'))" class="px-4 py-2 bg-primary text-white rounded-lg font-bold hover:bg-orange-600 transition-colors flex items-center gap-2 shadow-sm shadow-orange-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
        Tambah Klien
      </button>
    </div>
  </div>

  <div x-data="clientsData()" class="space-y-6">
    <!-- Filters & Search -->
    <div class="bg-white p-4 rounded-xl border border-border shadow-sm flex flex-col md:flex-row gap-4 justify-between items-center z-10 sticky top-0">
      <div class="relative w-full md:w-80">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" x-model="searchQuery" @input="filterItems" placeholder="Cari nama atau perusahaan..." class="w-full pl-9 pr-4 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
      </div>
      <div class="flex gap-2 w-full md:w-auto">
        <select x-model="statusFilter" @change="filterItems" class="px-4 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 outline-none w-full md:w-auto">
          <option value="all">Semua Status</option>
          <option value="Berjalan">Berjalan</option>
          <option value="Selesai">Selesai</option>
          <option value="Pending">Pending</option>
        </select>
        <button @click="loadItems()" class="p-2 text-gray-500 border border-gray-300 rounded-lg hover:text-primary hover:border-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" :class="{'animate-spin': loading}"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
        </button>
      </div>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl border border-border shadow-sm overflow-hidden">
      <!-- Loading State -->
      <div x-show="loading" class="p-12 text-center text-gray-400">
        <svg class="animate-spin h-8 w-8 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
        <p>Memuat data klien...</p>
      </div>

      <!-- Empty State -->
      <div x-show="!loading && filteredItems.length === 0" class="p-12 text-center text-gray-500" style="display: none;">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-gray-300"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <p class="text-lg font-medium text-dark mb-1">Belum ada klien ditemukan</p>
        <p class="text-sm">Silakan tambah klien baru atau ubah filter pencarian.</p>
      </div>

      <div class="overflow-x-auto" x-show="!loading && filteredItems.length > 0" style="display: none;">
        <table class="w-full text-left whitespace-nowrap">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Info Klien</th>
              <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Project & Status</th>
              <th class="px-6 py-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">Keuangan</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <template x-for="item in filteredItems" :key="item.id">
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-bold text-dark" x-text="item.name"></div>
                  <div class="text-sm text-gray-500" x-text="item.company || '-'"></div>
                  <div class="flex gap-2 mt-2">
                    <a x-show="item.phone" :href="'https://wa.me/' + item.phone.replace(/\D/g, '')" target="_blank" class="text-green-500 hover:text-green-600" title="WhatsApp">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </a>
                    <a x-show="item.email" :href="'mailto:' + item.email" class="text-blue-500 hover:text-blue-600" title="Email">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </a>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-dark" x-text="item.service || 'Project Umum'"></div>
                  <div class="text-xs text-gray-500 mt-1">Deadline: <span x-text="formatDate(item.deadline)"></span></div>
                  <div class="mt-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold" 
                          :class="{
                            'bg-green-100 text-green-700': item.status === 'Selesai',
                            'bg-blue-100 text-blue-700': item.status === 'Berjalan',
                            'bg-yellow-100 text-yellow-700': item.status === 'Pending'
                          }" x-text="item.status"></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-xs text-gray-500">Nilai: <span class="font-medium text-dark" x-text="formatCurrency(item.project_value)"></span></div>
                  <div class="text-xs text-gray-500 mt-1">Dibayar: <span class="font-medium text-green-600" x-text="formatCurrency(item.total_paid)"></span></div>
                  <div class="text-xs font-bold mt-1" :class="(item.project_value - item.total_paid) > 0 ? 'text-red-500' : 'text-green-500'">
                    Sisa: <span x-text="formatCurrency(Math.max(0, item.project_value - item.total_paid))"></span>
                  </div>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button @click="openEditModal(item)" class="p-2 text-gray-400 hover:text-blue-500 hover:bg-blue-50 rounded-lg transition-all" title="Edit">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    </button>
                    <button @click="deleteItem(item.id)" class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all" title="Hapus">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                    </button>
                  </div>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Client Form Modal -->
    <div x-show="modalOpen" style="display: none;" class="fixed inset-0 z-50 flex items-center justify-center">
      <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" @click="closeModal()"></div>
      <div class="bg-white w-full max-w-3xl rounded-2xl shadow-xl z-10 mx-4 max-h-[90vh] flex flex-col" x-transition.scale.origin.bottom>
        <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-2xl">
          <h3 class="text-xl font-bold text-dark" x-text="isEdit ? 'Edit Klien' : 'Tambah Klien Baru'"></h3>
          <button @click="closeModal()" class="text-gray-400 hover:text-dark">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
        
        <div class="p-6 overflow-y-auto flex-grow">
          <form @submit.prevent="saveItem" id="clientForm" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Profil -->
            <div class="md:col-span-2 border-b border-gray-100 pb-2 mb-2">
              <h4 class="font-bold text-dark text-sm uppercase tracking-wider">Profil Klien</h4>
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Nama Klien <span class="text-red-500">*</span></label>
              <input type="text" x-model="form.name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Nama Perusahaan</label>
              <input type="text" x-model="form.company" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Email</label>
              <input type="email" x-model="form.email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">No WhatsApp</label>
              <input type="text" x-model="form.phone" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="628xxx">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-bold text-dark mb-1">Alamat</label>
              <textarea x-model="form.address" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none"></textarea>
            </div>

            <!-- Project Details -->
            <div class="md:col-span-2 border-b border-gray-100 pb-2 mb-2 mt-4">
              <h4 class="font-bold text-dark text-sm uppercase tracking-wider">Detail Project & Keuangan</h4>
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Nama Layanan / Project</label>
              <input type="text" x-model="form.service" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Status Project</label>
              <select x-model="form.status" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none bg-white">
                <option value="Berjalan">Berjalan</option>
                <option value="Selesai">Selesai</option>
                <option value="Pending">Pending</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Nilai Project (Rp)</label>
              <input type="number" x-model="form.project_value" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Sudah Dibayar (Rp)</label>
              <input type="number" x-model="form.total_paid" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Tanggal Mulai</label>
              <input type="date" x-model="form.start_date" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div>
              <label class="block text-sm font-bold text-dark mb-1">Deadline</label>
              <input type="date" x-model="form.deadline" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-bold text-dark mb-1">Catatan</label>
              <textarea x-model="form.notes" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none"></textarea>
            </div>
          </form>
        </div>
        
        <div class="p-6 border-t border-gray-100 flex justify-end gap-3 bg-gray-50 rounded-b-2xl">
          <button type="button" @click="closeModal()" class="px-5 py-2.5 bg-gray-200 text-dark font-bold rounded-lg hover:bg-gray-300 transition-colors">Batal</button>
          <button type="submit" form="clientForm" class="px-5 py-2.5 bg-primary text-white font-bold rounded-lg hover:bg-orange-600 transition-colors flex items-center gap-2" :disabled="submitting">
            <span x-show="!submitting">Simpan Data</span>
            <span x-show="submitting" style="display: none;">Menyimpan...</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../../../lib/supabase';

  document.addEventListener('alpine:init', () => {
    // Also listen for external trigger
    document.addEventListener('open-client-modal', () => {
      window.dispatchEvent(new CustomEvent('alpine-open-client-modal'));
    });

    window.Alpine.data('clientsData', () => ({
      items: [],
      filteredItems: [],
      searchQuery: '',
      statusFilter: 'all',
      loading: true,
      
      modalOpen: false,
      isEdit: false,
      submitting: false,
      
      form: {
        id: null,
        name: '', company: '', email: '', phone: '', address: '', website: '',
        service: '', project_value: 0, status: 'Berjalan', total_paid: 0,
        start_date: '', deadline: '', notes: ''
      },

      async init() {
        await this.loadItems();
        window.addEventListener('alpine-open-client-modal', () => this.openCreateModal());
      },

      async loadItems() {
        this.loading = true;
        try {
          const { data, error } = await supabase
            .from('clients')
            .select('*')
            .eq('is_deleted', false)
            .order('created_at', { ascending: false });
            
          if (error) throw error;
          this.items = data || [];
          this.filterItems();
        } catch (error) {
          console.error('Error:', error);
          if (error.code === '42P01') {
            alert('Tabel clients belum ada. Harap jalankan migrasi SQL.');
          }
        } finally {
          this.loading = false;
        }
      },

      filterItems() {
        let result = this.items;
        
        if (this.statusFilter !== 'all') {
          result = result.filter(item => item.status === this.statusFilter);
        }
        
        if (this.searchQuery) {
          const q = this.searchQuery.toLowerCase();
          result = result.filter(item => 
            (item.name && item.name.toLowerCase().includes(q)) || 
            (item.company && item.company.toLowerCase().includes(q)) ||
            (item.service && item.service.toLowerCase().includes(q))
          );
        }
        
        this.filteredItems = result;
      },

      formatCurrency(val) {
        if (!val) return 'Rp 0';
        return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
      },
      
      formatDate(dateStr) {
        if (!dateStr) return '-';
        return new Date(dateStr).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' });
      },

      openCreateModal() {
        this.isEdit = false;
        this.form = {
          id: null, name: '', company: '', email: '', phone: '', address: '', website: '',
          service: '', project_value: 0, status: 'Berjalan', total_paid: 0,
          start_date: new Date().toISOString().split('T')[0], deadline: '', notes: ''
        };
        this.modalOpen = true;
      },

      openEditModal(item) {
        this.isEdit = true;
        this.form = { ...item };
        // fix dates for input
        if (this.form.start_date) this.form.start_date = this.form.start_date.split('T')[0];
        if (this.form.deadline) this.form.deadline = this.form.deadline.split('T')[0];
        this.modalOpen = true;
      },

      closeModal() {
        this.modalOpen = false;
      },

      async saveItem() {
        this.submitting = true;
        try {
          const payload = { ...this.form };
          const id = payload.id;
          delete payload.id; // remove id from insert/update payload

          // Sanitize empty strings for date and numeric fields
          if (!payload.start_date) payload.start_date = null;
          if (!payload.deadline) payload.deadline = null;
          if (payload.project_value === "" || payload.project_value === null) payload.project_value = 0;
          if (payload.total_paid === "" || payload.total_paid === null) payload.total_paid = 0;

          if (this.isEdit) {
            const { error } = await supabase.from('clients').update(payload).eq('id', id);
            if (error) throw error;
          } else {
            const { error } = await supabase.from('clients').insert([payload]);
            if (error) throw error;
          }
          
          this.closeModal();
          await this.loadItems();
          // Ideally use toast here
        } catch (error) {
          console.error("Save error:", error);
          alert('Gagal menyimpan data klien.');
        } finally {
          this.submitting = false;
        }
      },

      async deleteItem(id) {
        if (!confirm('Hapus klien ini? (Soft Delete)')) return;
        
        try {
          // Soft delete
          const { error } = await supabase.from('clients').update({ is_deleted: true }).eq('id', id);
          if (error) throw error;
          await this.loadItems();
        } catch (error) {
          console.error('Delete error:', error);
          alert('Gagal menghapus data.');
        }
      }
    }));
  });
</script>
