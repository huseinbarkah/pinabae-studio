---
export const prerender = false;
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { supabase } from '../../../../../lib/supabase';

const { id } = Astro.params;

let initialData = null;
try {
  const { data } = await supabase.from('blog_authors').select('*').eq('id', id).single();
  if (data) initialData = data;
} catch (e) {
  console.error(e);
}

if (!initialData) {
  return Astro.redirect('/admin/blog/authors');
}
---

<AdminLayout title="Edit Author | Admin Pinabae">
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-dark">Edit Author Blog</h1>
      <p class="text-text">Perbarui profil penulis artikel blog.</p>
    </div>
    <a href="/admin/blog/authors" class="px-4 py-2 bg-gray-100 text-dark rounded-lg font-medium hover:bg-gray-200 transition-colors flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Batal
    </a>
  </div>

  <form x-data="editAuthorData()" @submit.prevent="saveAuthor" class="grid grid-cols-1 lg:grid-cols-3 gap-8 pb-12">
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <div class="mb-6">
          <label class="block text-sm font-bold text-dark mb-2">Nama Lengkap <span class="text-red-500">*</span></label>
          <input type="text" x-model="author.name" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" required>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Jabatan (Posisi)</label>
            <input type="text" x-model="author.position" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Email</label>
            <input type="email" x-model="author.email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-bold text-dark mb-2">Biografi Singkat</label>
          <textarea x-model="author.biography" rows="4" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none"></textarea>
        </div>
      </div>
      
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Sosial Media & Tautan (Opsional)</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-bold text-dark mb-2">URL LinkedIn</label>
            <input type="url" x-model="author.linkedin_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">URL Instagram</label>
            <input type="url" x-model="author.instagram_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">URL GitHub</label>
            <input type="url" x-model="author.github_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Website / Portofolio</label>
            <input type="url" x-model="author.website_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Simpan Perubahan</h2>
        
        <button type="submit" class="w-full py-3 bg-primary text-white rounded-lg font-bold hover:bg-orange-600 transition-colors flex justify-center items-center gap-2 shadow-sm shadow-orange-500/20" :disabled="submitting">
          <span x-show="!submitting">Perbarui Author</span>
          <span x-show="submitting" style="display: none;">
            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            Menyimpan...
          </span>
        </button>
      </div>

      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Foto Profil</h2>
        
        <div x-show="!author.photo_url" class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center cursor-pointer hover:bg-gray-50 transition-colors" @click="$refs.fileInput.click()">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-gray-400 mb-2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <span class="text-sm font-medium text-primary">Upload Foto</span>
        </div>
        
        <div x-show="author.photo_url" class="relative group">
          <img :src="author.photo_url" class="w-full h-auto rounded-lg border border-gray-200 aspect-[3/4] object-cover">
          <button type="button" @click="author.photo_url = ''" class="absolute top-2 right-2 p-1.5 bg-red-500 text-white rounded-md opacity-0 group-hover:opacity-100 transition-opacity shadow-sm" title="Hapus Gambar">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
        
        <input type="file" x-ref="fileInput" class="hidden" accept="image/*" @change="uploadImage">
        
        <div x-show="uploadingImage" class="mt-2 text-sm text-primary flex items-center gap-2" style="display: none;">
          <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          Mengunggah gambar...
        </div>
      </div>
    </div>
  </form>
</AdminLayout>

<script define:vars={{ authorId: id, initialData }}>
  window.__EDIT_AUTHOR_ID__ = authorId;
  window.__EDIT_INITIAL_DATA__ = initialData;
</script>

<script>
  import { supabase } from '../../../../../lib/supabase';

  document.addEventListener('alpine:init', () => {
    window.Alpine.data('editAuthorData', () => ({
      submitting: false,
      uploadingImage: false,
      author: window.__EDIT_INITIAL_DATA__ || {
        name: '',
        position: '',
        biography: '',
        photo_url: '',
        linkedin_url: '',
        instagram_url: '',
        github_url: '',
        website_url: '',
        email: ''
      },

      async uploadImage(event: any) {
        const file = event.target.files[0];
        if (!file) return;

        this.uploadingImage = true;
        try {
          const formData = new FormData();
          formData.append('file', file);
          formData.append('folder', 'authors');

          const sessionData = await supabase.auth.getSession();
          const token = sessionData.data.session?.access_token;

          const res = await fetch('/api/upload', { 
            method: 'POST', 
            body: formData,
            headers: token ? { 'Authorization': `Bearer ${token}` } : {}
          });
          const result = await res.json();
          if (!res.ok) throw new Error(result.error || 'Upload failed');

          this.author.photo_url = result.url;
        } catch (error: any) {
          console.error('Error uploading image:', error);
          alert('Gagal mengunggah gambar. Pesan: ' + (error.message || ''));
        } finally {
          this.uploadingImage = false;
          event.target.value = '';
        }
      },

      async saveAuthor() {
        if (!this.author.name) {
          alert('Nama author wajib diisi!');
          return;
        }

        this.submitting = true;
        try {
          const { id, created_at, ...updateData } = this.author;

          const { error } = await supabase
            .from('blog_authors')
            .update(updateData)
            .eq('id', window.__EDIT_AUTHOR_ID__);

          if (error) throw error;

          alert('Berhasil memperbarui author!');
          window.location.href = '/admin/blog/authors';
        } catch (error: any) {
          console.error('Error saving author:', error);
          alert('Gagal memperbarui author. Pesan: ' + (error.message || JSON.stringify(error)));
        } finally {
          this.submitting = false;
        }
      }
    }));
  });
</script>
