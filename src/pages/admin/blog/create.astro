---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Tulis Artikel | Admin Pinabae">
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-dark">Tulis Artikel Baru</h1>
      <p class="text-text">Buat konten menarik untuk blog Anda.</p>
    </div>
    <a href="/admin/blog" class="px-4 py-2 bg-gray-100 text-dark rounded-lg font-medium hover:bg-gray-200 transition-colors flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Batal
    </a>
  </div>

  <form x-data="createPostData()" @submit.prevent="savePost" class="grid grid-cols-1 lg:grid-cols-3 gap-8 pb-12">
    <!-- Main Content Area -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- General Content -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <div class="mb-6">
          <label class="block text-sm font-bold text-dark mb-2">Judul Artikel</label>
          <input type="text" x-model="post.title" @input="generateSlug" class="w-full px-4 py-3 text-lg font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Masukkan judul artikel yang menarik..." required>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-bold text-dark mb-2">Konten Artikel</label>
          <!-- Editor Toolbar -->
          <div class="flex flex-wrap items-center gap-1 p-2 bg-gray-50 border border-b-0 border-gray-300 rounded-t-lg">
            <!-- Basic formatting -->
            <button type="button" @click="editor.chain().focus().toggleBold().run()" class="p-2 rounded hover:bg-gray-200" :class="{ 'bg-gray-200': editor?.isActive('bold') }" title="Bold">B</button>
            <button type="button" @click="editor.chain().focus().toggleItalic().run()" class="p-2 rounded hover:bg-gray-200" :class="{ 'bg-gray-200': editor?.isActive('italic') }" title="Italic">I</button>
            <div class="w-px h-6 bg-gray-300 mx-1"></div>
            <!-- Headings -->
            <button type="button" @click="editor.chain().focus().toggleHeading({ level: 2 }).run()" class="p-2 rounded hover:bg-gray-200 font-bold" :class="{ 'bg-gray-200': editor?.isActive('heading', { level: 2 }) }" title="Heading 2">H2</button>
            <button type="button" @click="editor.chain().focus().toggleHeading({ level: 3 }).run()" class="p-2 rounded hover:bg-gray-200 font-bold" :class="{ 'bg-gray-200': editor?.isActive('heading', { level: 3 }) }" title="Heading 3">H3</button>
            <div class="w-px h-6 bg-gray-300 mx-1"></div>
            <!-- Lists -->
            <button type="button" @click="editor.chain().focus().toggleBulletList().run()" class="p-2 rounded hover:bg-gray-200" :class="{ 'bg-gray-200': editor?.isActive('bulletList') }" title="Bullet List">Ul</button>
            <button type="button" @click="editor.chain().focus().toggleOrderedList().run()" class="p-2 rounded hover:bg-gray-200" :class="{ 'bg-gray-200': editor?.isActive('orderedList') }" title="Ordered List">Ol</button>
            <button type="button" @click="editor.chain().focus().toggleTaskList().run()" class="p-2 rounded hover:bg-gray-200" :class="{ 'bg-gray-200': editor?.isActive('taskList') }" title="Task List">[]</button>
            <div class="w-px h-6 bg-gray-300 mx-1"></div>
            <button type="button" @click="editor.chain().focus().toggleBlockquote().run()" class="p-2 rounded hover:bg-gray-200" :class="{ 'bg-gray-200': editor?.isActive('blockquote') }" title="Quote">""</button>
            <div class="w-px h-6 bg-gray-300 mx-1"></div>
            <!-- Tables -->
            <button type="button" @click="editor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run()" class="p-2 rounded hover:bg-gray-200" title="Insert Table">Tbl</button>
            <button type="button" @click="editor.chain().focus().deleteTable().run()" class="p-2 rounded hover:bg-gray-200 text-red-500" title="Delete Table">xTbl</button>
            <div class="w-px h-6 bg-gray-300 mx-1"></div>
            <!-- Custom Blocks -->
            <button type="button" @click="editor.chain().focus().insertContent('<div class=\'custom-callout callout-info\'><p>Callout Info</p></div>').run()" class="p-2 rounded hover:bg-gray-200 text-blue-500 font-bold" title="Callout">Info</button>
            <button type="button" @click="editor.chain().focus().insertContent('<div class=\'custom-callout callout-warning\'><p>Warning / Tips</p></div>').run()" class="p-2 rounded hover:bg-gray-200 text-orange-500 font-bold" title="Warning">Warn</button>
            <div class="w-px h-6 bg-gray-300 mx-1"></div>
            <!-- Insert Image Button -->
            <button type="button" @click="promptInsertImage" class="p-2 rounded hover:bg-gray-200" title="Insert Image">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </button>
          </div>
          <!-- Editor Content -->
          <div class="editor-content p-4 min-h-[400px] border border-gray-300 rounded-b-lg focus-within:ring-2 focus-within:ring-primary/50 focus-within:border-primary prose max-w-none" x-ref="editorElement"></div>
        </div>

        <div>
          <label class="block text-sm font-bold text-dark mb-2">Ringkasan (Excerpt)</label>
          <textarea x-model="post.excerpt" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Tulis ringkasan singkat artikel ini..."></textarea>
          <p class="text-xs text-gray-500 mt-1">Muncul di halaman daftar blog dan hasil pencarian Google.</p>
        </div>
      </div>

      <!-- Key Takeaways -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Key Takeaways (Poin Penting)</h2>
        <div class="space-y-3 mb-4">
          <template x-for="(tk, index) in keyTakeaways" :key="index">
            <div class="flex gap-2 items-start">
              <span class="mt-2 text-primary">✓</span>
              <input type="text" x-model="keyTakeaways[index]" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
              <button type="button" @click="keyTakeaways.splice(index, 1)" class="p-2 text-red-500 hover:bg-red-50 rounded-lg mt-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </div>
          </template>
        </div>
        <button type="button" @click="keyTakeaways.push('')" class="text-sm font-medium text-primary hover:underline">+ Tambah Poin</button>
      </div>

      <!-- SEO Options -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Optimasi SEO</h2>
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-bold text-dark mb-1">Meta Title</label>
            <input type="text" x-model="post.meta_title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Opsional. Kosongkan untuk menggunakan Judul Artikel">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-1">Meta Description</label>
            <textarea x-model="post.meta_description" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Opsional. Kosongkan untuk menggunakan Excerpt"></textarea>
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-1">Meta Keywords</label>
            <input type="text" x-model="post.meta_keywords" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Contoh: digital agency, marketing, seo">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-1">Canonical URL</label>
            <input type="url" x-model="post.canonical_url" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="https://...">
          </div>
          <div class="pt-4 border-t border-gray-100">
            <h3 class="text-md font-bold text-dark mb-3">Open Graph (Sosial Media)</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-bold text-dark mb-1">OG Title</label>
                <input type="text" x-model="post.og_title" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Opsional. Default: SEO Title">
              </div>
              <div>
                <label class="block text-sm font-bold text-dark mb-1">OG Description</label>
                <textarea x-model="post.og_description" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Opsional. Default: SEO Description"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-dark mb-1">OG Image URL</label>
                <input type="url" x-model="post.og_image" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Opsional. Default: Featured Image">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar / Settings -->
    <div class="space-y-6">
      
      <!-- Publish Box -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Status & Publikasi</h2>
        
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-dark mb-1">Status</label>
            <select x-model="post.status" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none bg-white">
              <option value="draft">Draft (Simpan Sementara)</option>
              <option value="published">Publish (Tayangkan)</option>
            </select>
          </div>
          
          <button type="submit" class="w-full py-3 bg-primary text-white rounded-lg font-bold hover:bg-orange-600 transition-colors flex justify-center items-center gap-2 shadow-sm shadow-orange-500/20" :disabled="submitting">
            <span x-show="!submitting">Simpan Artikel</span>
            <span x-show="submitting" style="display: none;">
              <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            </span>
          </button>
        </div>
      </div>

      <!-- Additional Settings -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Pengaturan Tambahan</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-bold text-dark mb-1">Penulis (Author)</label>
            <select x-model="post.author_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg outline-none bg-white text-sm">
              <option value="">-- Pilih Author --</option>
              <template x-for="author in authors" :key="author.id">
                <option :value="author.id" x-text="author.name"></option>
              </template>
            </select>
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-1">Estimasi Waktu Baca (Menit)</label>
            <div class="flex items-center gap-2">
              <input type="number" x-model.number="post.estimated_read_time" class="w-20 px-3 py-2 border border-gray-300 rounded-lg outline-none" min="1">
              <button type="button" @click="calculateReadTime" class="text-xs text-primary font-medium bg-orange-50 px-2 py-1 rounded hover:bg-orange-100">Auto Hitung</button>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <input type="checkbox" id="cta_enabled" x-model="post.cta_enabled" class="text-primary focus:ring-primary w-4 h-4">
            <label for="cta_enabled" class="text-sm font-bold text-dark">Tampilkan Banner CTA di bawah</label>
          </div>
        </div>
      </div>

      <!-- Categories & Tags -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Kategori & Tag</h2>
        
        <div class="mb-4">
          <label class="block text-sm font-bold text-dark mb-2">Kategori Utama</label>
          <div x-show="categories.length === 0" class="text-sm text-gray-500 italic mb-2">Memuat...</div>
          <div class="space-y-2 max-h-32 overflow-y-auto">
            <template x-for="cat in categories" :key="cat.id">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" :value="cat.id" x-model="post.category_id" name="category" class="text-primary focus:ring-primary h-4 w-4">
                <span class="text-sm text-dark" x-text="cat.name"></span>
              </label>
            </template>
          </div>
        </div>

        <div>
          <label class="block text-sm font-bold text-dark mb-2">Tag</label>
          <div x-show="tagsList.length === 0" class="text-sm text-gray-500 italic mb-2">Memuat...</div>
          <div class="flex flex-wrap gap-2">
            <template x-for="t in tagsList" :key="t.id">
              <label class="inline-flex items-center gap-1.5 px-2 py-1 bg-gray-50 border border-gray-200 rounded-md cursor-pointer hover:bg-gray-100 transition-colors">
                <input type="checkbox" :value="t.id" x-model="selectedTags" class="text-primary focus:ring-primary h-3 w-3">
                <span class="text-xs text-dark" x-text="t.name"></span>
              </label>
            </template>
          </div>
        </div>
      </div>

      <!-- Featured Image -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Featured Image</h2>
        
        <div x-show="!post.featured_image" class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center cursor-pointer hover:bg-gray-50 transition-colors" @click="$refs.fileInput.click()">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-gray-400 mb-2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <span class="text-sm font-medium text-primary">Upload Gambar Utama</span>
        </div>
        
        <div x-show="post.featured_image" class="relative group" style="display: none;">
          <img :src="post.featured_image" class="w-full h-auto rounded-lg border border-gray-200">
          <button type="button" @click="post.featured_image = ''" class="absolute top-2 right-2 p-1.5 bg-red-500 text-white rounded-md opacity-0 group-hover:opacity-100 transition-opacity shadow-sm" title="Hapus Gambar">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>

        <div class="mt-4" x-show="post.featured_image" style="display: none;">
          <label class="block text-xs font-bold text-dark mb-1">Alt Text</label>
          <input type="text" x-model="post.alt_featured_image" class="w-full px-3 py-1.5 border border-gray-300 rounded-lg text-sm outline-none focus:border-primary" placeholder="Deskripsi gambar (untuk SEO)">
        </div>
        
        <!-- Hidden file input for feature image -->
        <input type="file" x-ref="fileInput" class="hidden" accept="image/*" @change="uploadImage($event, 'featured')">
        <!-- Hidden file input for content images -->
        <input type="file" x-ref="contentFileInput" class="hidden" accept="image/*" @change="uploadImage($event, 'content')">
        
        <div x-show="uploadingImage" class="mt-2 text-sm text-primary flex items-center gap-2" style="display: none;">
          <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          Mengunggah...
        </div>
      </div>

      <!-- SEO URL Box -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Pengaturan URL (Slug)</h2>
        <input type="text" x-model="post.slug" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none text-sm bg-gray-50" required>
        <p class="text-xs text-gray-500 mt-1">Dibuat otomatis dari judul.</p>
      </div>
    </div>
  </form>
</AdminLayout>

<style is:global>
  /* Tiptap styles */
  .ProseMirror {
    outline: none !important;
    min-height: 400px;
  }
  .ProseMirror p { margin-bottom: 1rem; }
  .ProseMirror h2 { font-size: 1.5rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; }
  .ProseMirror h3 { font-size: 1.25rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: 1rem; }
  .ProseMirror ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 1rem; }
  .ProseMirror ol { list-style-type: decimal; padding-left: 1.5rem; margin-bottom: 1rem; }
  .ProseMirror blockquote { border-left: 4px solid #F57C00; padding-left: 1rem; margin-left: 0; margin-right: 0; font-style: italic; color: #4b5563; }
  .ProseMirror img { max-width: 100%; height: auto; border-radius: 0.5rem; margin: 1.5rem 0; }
  
  /* Task List */
  ul[data-type="taskList"] { list-style: none; padding: 0; }
  ul[data-type="taskList"] li { display: flex; align-items: flex-start; margin-bottom: 0.5rem; }
  ul[data-type="taskList"] li > label { margin-right: 0.5rem; user-select: none; }
  
  /* Tables */
  .ProseMirror table { border-collapse: collapse; margin: 0; overflow: hidden; table-layout: fixed; width: 100%; }
  .ProseMirror table td, .ProseMirror table th { border: 2px solid #ced4da; box-sizing: border-box; min-width: 1em; padding: 3px 5px; position: relative; vertical-align: top; }
  .ProseMirror table th { background-color: #f1f3f5; font-weight: bold; text-align: left; }
  
  /* Custom Callouts */
  .custom-callout { padding: 1rem; border-radius: 0.5rem; margin: 1.5rem 0; }
  .callout-info { background-color: #eff6ff; border-left: 4px solid #3b82f6; color: #1e3a8a; }
  .callout-warning { background-color: #fff7ed; border-left: 4px solid #f97316; color: #9a3412; }
</style>

<script>
  import { supabase } from '../../../lib/supabase';
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Image from '@tiptap/extension-image';
  import { Table } from '@tiptap/extension-table';
  import { TableRow } from '@tiptap/extension-table-row';
  import { TableHeader } from '@tiptap/extension-table-header';
  import { TableCell } from '@tiptap/extension-table-cell';
  import { TaskList } from '@tiptap/extension-task-list';
  import { TaskItem } from '@tiptap/extension-task-item';

  document.addEventListener('alpine:init', () => {
    window.Alpine.data('createPostData', () => ({
      editor: null,
      categories: [],
      authors: [],
      tagsList: [],
      selectedTags: [],
      keyTakeaways: [],
      submitting: false,
      uploadingImage: false,
      
      post: {
        title: '',
        slug: '',
        excerpt: '',
        content: '',
        featured_image: '',
        alt_featured_image: '',
        status: 'draft',
        category_id: '',
        author_id: '',
        meta_title: '',
        meta_description: '',
        meta_keywords: '',
        canonical_url: '',
        og_title: '',
        og_description: '',
        og_image: '',
        estimated_read_time: 3,
        cta_enabled: true
      },

      async init() {
        // Load relationships
        const [catRes, authRes, tagRes] = await Promise.all([
          supabase.from('categories').select('*').order('name'),
          supabase.from('blog_authors').select('id, name').order('name'),
          supabase.from('blog_tags').select('id, name').order('name')
        ]);
        
        if (catRes.data) this.categories = catRes.data;
        if (authRes.data) this.authors = authRes.data;
        if (tagRes.data) this.tagsList = tagRes.data;

        // Initialize Tiptap
        this.editor = new Editor({
          element: this.$refs.editorElement,
          extensions: [
            StarterKit,
            Image.configure({ HTMLAttributes: { class: 'rounded-lg border border-gray-200 shadow-sm' } }),
            Table.configure({ resizable: true }),
            TableRow,
            TableHeader,
            TableCell,
            TaskList,
            TaskItem.configure({ nested: true }),
          ],
          content: '',
          onUpdate: ({ editor }) => {
            this.post.content = editor.getHTML();
          },
        });
      },

      generateSlug() {
        this.post.slug = this.post.title
          .toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
      },
      
      calculateReadTime() {
        if (!this.post.content) return;
        const text = this.post.content.replace(/<[^>]*>?/gm, ''); // strip HTML
        const wordCount = text.split(/\s+/).length;
        const readTime = Math.ceil(wordCount / 200); // 200 words per min
        this.post.estimated_read_time = readTime > 0 ? readTime : 1;
      },

      promptInsertImage() {
        this.$refs.contentFileInput.click();
      },

      async uploadImage(event, type) {
        const file = event.target.files[0];
        if (!file) return;

        this.uploadingImage = true;
        try {
          const formData = new FormData();
          formData.append('file', file);
          formData.append('folder', 'blog');

          const sessionData = await supabase.auth.getSession();
          const token = sessionData.data.session?.access_token;

          const res = await fetch('/api/upload', {
            method: 'POST',
            body: formData,
            headers: token ? { 'Authorization': `Bearer ${token}` } : {}
          });

          const result = await res.json();
          if (!res.ok) throw new Error(result.error || 'Upload failed');

          if (type === 'featured') {
            this.post.featured_image = result.url;
          } else if (type === 'content') {
            this.editor.chain().focus().setImage({ src: result.url }).run();
          }
        } catch (error: any) {
          console.error('Error uploading image:', error);
          alert('Gagal mengunggah gambar. Pesan: ' + (error.message || JSON.stringify(error)));
        } finally {
          this.uploadingImage = false;
          event.target.value = ''; // Reset input
        }
      },

      async savePost() {
        if (!this.post.title || !this.post.slug) {
          alert('Judul dan Slug wajib diisi!');
          return;
        }

        this.submitting = true;
        try {
          const postData = {
            ...this.post,
            key_takeaways: this.keyTakeaways.filter(t => t.trim() !== ''),
            published_at: this.post.status === 'published' ? new Date().toISOString() : null
          };
          
          // Use explicit null for missing relations to override any Postgres defaults
          postData.category_id = postData.category_id || null;
          postData.author_id = postData.author_id || null;

          const { data: insertedPost, error } = await supabase
            .from('blog_posts')
            .insert([postData])
            .select()
            .single();

          if (error) {
            if (error.code === '23505') {
              alert('Slug sudah digunakan, silakan ubah sedikit judulnya.');
            } else {
              throw error;
            }
            return;
          }
          
          // Insert tags if any selected
          if (insertedPost && this.selectedTags.length > 0) {
            const tagsToInsert = this.selectedTags.map(tagId => ({
              post_id: insertedPost.id,
              tag_id: tagId
            }));
            
            await supabase.from('post_tags').insert(tagsToInsert);
          }

          alert('Artikel berhasil disimpan!');
          window.location.href = '/admin/blog';
        } catch (error: any) {
          console.error('Error saving post:', error);
          alert('Gagal menyimpan artikel. Pesan: ' + (error.message || JSON.stringify(error)));
        } finally {
          this.submitting = false;
        }
      }
    }));
  });
</script>
