---
export const prerender = false;
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { supabase } from '../../../../lib/supabase';

const { id } = Astro.params;

let initialData = null;
try {
  const { data } = await supabase.from('services').select('*').eq('id', id).single();
  if (data) initialData = data;
} catch (e) {
  console.error(e);
}

if (!initialData) {
  return Astro.redirect('/admin/services');
}
---

<AdminLayout title="Edit Layanan | Admin Pinabae">
  <div class="mb-8 flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold text-dark">Edit Layanan</h1>
      <p class="text-text">Perbarui informasi layanan.</p>
    </div>
    <a href="/admin/services" class="px-4 py-2 bg-gray-100 text-dark rounded-lg font-medium hover:bg-gray-200 transition-colors flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Batal
    </a>
  </div>

  <form x-data="editServiceData()" @submit.prevent="updateService" class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-12" id="service-form">
    <!-- Main Content Area -->
    <div class="lg:col-span-7 xl:col-span-8 space-y-6">
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Informasi Utama</h2>
        
        <div class="mb-6">
          <label class="block text-sm font-bold text-dark mb-2">Nama Layanan <span class="text-red-500">*</span></label>
          <input type="text" x-model="service.title" @input="generateSlug" class="w-full px-4 py-3 text-lg font-bold border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" required>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-bold text-dark mb-2">Deskripsi Singkat <span class="text-red-500">*</span></label>
          <textarea x-model="service.description" rows="3" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" required></textarea>
        </div>

        <div class="mb-6 grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Nama Icon (Lucide)</label>
            <input type="text" x-model="service.icon" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
            <p class="text-xs text-gray-500 mt-1"><a href="https://lucide.dev/icons/" target="_blank" class="text-primary hover:underline">Referensi Lucide Icons</a>.</p>
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Harga Mulai Dari</label>
            <input type="text" x-model="service.price_starts_from" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Contoh: Rp 1.500.000">
          </div>
        </div>
      </div>

      <!-- Badges Array -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Badge Kategori (Cocok Untuk)</h2>
        <div class="mb-4">
          <div class="flex gap-2">
            <input type="text" x-model="newBadge" @keydown.enter.prevent="addBadge" class="flex-grow px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Contoh: UMKM">
            <button type="button" @click="addBadge" class="px-4 py-2 bg-gray-100 text-dark font-medium rounded-lg hover:bg-gray-200">Tambah</button>
          </div>
          <p class="text-xs text-gray-500 mt-1">Tekan Enter untuk menambah badge.</p>
        </div>
        
        <div class="flex flex-wrap gap-2">
          <template x-for="(badge, index) in service.badges" :key="index">
            <div class="inline-flex items-center gap-1 px-3 py-1 bg-orange-50 text-primary text-sm font-medium rounded-full border border-orange-100">
              <span x-text="badge"></span>
              <button type="button" @click="removeBadge(index)" class="text-primary hover:text-red-500 ml-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </div>
          </template>
          <div x-show="service.badges.length === 0" class="text-sm text-gray-400">Belum ada badge ditambahkan.</div>
        </div>
      </div>

      <!-- Benefits Array -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Benefit Layanan</h2>
        <div class="mb-4">
          <div class="flex gap-2">
            <input type="text" x-model="newBenefit" @keydown.enter.prevent="addBenefit" class="flex-grow px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Contoh: Meningkatkan kredibilitas bisnis">
            <button type="button" @click="addBenefit" class="px-4 py-2 bg-gray-100 text-dark font-medium rounded-lg hover:bg-gray-200">Tambah</button>
          </div>
        </div>
        
        <div class="space-y-2">
          <template x-for="(benefit, index) in service.benefits" :key="index">
            <div class="flex items-center justify-between p-3 bg-gray-50 border border-gray-200 rounded-lg">
              <div class="flex items-center gap-3">
                <span class="text-gray-400 font-mono text-xs" x-text="(index+1)+'.'"></span>
                <span class="text-sm text-dark font-medium" x-text="benefit"></span>
              </div>
              <div class="flex items-center gap-1">
                <button type="button" @click="moveBenefit(index, -1)" :disabled="index === 0" class="p-1 text-gray-400 hover:text-dark disabled:opacity-30">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
                </button>
                <button type="button" @click="moveBenefit(index, 1)" :disabled="index === service.benefits.length - 1" class="p-1 text-gray-400 hover:text-dark disabled:opacity-30">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <button type="button" @click="removeBenefit(index)" class="p-1 text-gray-400 hover:text-red-500 ml-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                </button>
              </div>
            </div>
          </template>
          <div x-show="service.benefits.length === 0" class="text-sm text-gray-400 p-3 text-center border border-dashed border-gray-200 rounded-lg">Belum ada benefit ditambahkan.</div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Pengaturan Tambahan</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Teks Tombol CTA</label>
            <input type="text" x-model="service.cta_text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Pelajari Lebih Lanjut">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Link Tombol CTA (Opsional)</label>
            <input type="text" x-model="service.cta_link" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none" placeholder="Kosongkan untuk link ke detail">
          </div>
          <div>
            <label class="block text-sm font-bold text-dark mb-2">Urutan Tampil (Angka)</label>
            <input type="number" x-model="service.order_index" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none">
          </div>
          <div class="flex items-center h-full pt-6">
            <label class="flex items-center cursor-pointer">
              <div class="relative">
                <input type="checkbox" x-model="service.is_active" class="sr-only">
                <div class="block bg-gray-200 w-10 h-6 rounded-full transition-colors" :class="{'bg-primary': service.is_active}"></div>
                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform" :class="{'transform translate-x-4': service.is_active}"></div>
              </div>
              <div class="ml-3 text-sm font-bold text-dark">Layanan Aktif</div>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-5 xl:col-span-4 space-y-6">
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm sticky top-24 z-10">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Simpan</h2>
        <button type="submit" class="w-full py-3 bg-primary text-white rounded-lg font-bold hover:bg-orange-600 transition-colors flex justify-center items-center gap-2 shadow-sm shadow-orange-500/20" :disabled="submitting">
          <span x-show="!submitting">Perbarui Layanan</span>
          <span x-show="submitting" style="display: none;">
            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </span>
        </button>
      </div>

      <div class="bg-white p-6 rounded-xl border border-border shadow-sm">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Slug URL <span class="text-red-500">*</span></h2>
        <input type="text" x-model="service.slug" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none text-sm bg-gray-50" required>
      </div>

      <!-- Live Preview -->
      <div class="bg-white p-6 rounded-xl border border-border shadow-sm hidden md:block">
        <h2 class="text-lg font-bold text-dark mb-4 border-b border-gray-100 pb-2">Live Preview Card</h2>
        
        <!-- Replica of the Frontend Card -->
        <div class="bg-white rounded-3xl p-6 border border-gray-200 shadow-lg relative overflow-hidden transition-all duration-300 transform scale-[0.9] origin-top">
          <!-- Icon & Badges -->
          <div class="flex flex-col gap-4 items-start mb-6">
            <div class="w-14 h-14 rounded-2xl bg-orange-50 flex items-center justify-center">
              <i :data-lucide="service.icon || 'box'" class="text-primary w-7 h-7"></i>
            </div>
            
            <div class="flex flex-wrap gap-1">
              <template x-for="badge in service.badges">
                <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 text-[10px] font-bold uppercase tracking-wider rounded-full" x-text="badge"></span>
              </template>
              <template x-if="service.badges.length === 0 && service.badge_text">
                 <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 text-[10px] font-bold uppercase tracking-wider rounded-full" x-text="service.badge_text"></span>
              </template>
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-dark mb-3 tracking-tight" x-text="service.title || 'Nama Layanan'"></h3>
          <p class="text-text text-sm leading-relaxed mb-6 line-clamp-3" x-text="service.description || 'Deskripsi singkat layanan akan tampil di sini...'"></p>
          
          <!-- Benefits -->
          <div class="space-y-2 mb-6">
            <template x-for="benefit in (service.benefits.length > 0 ? service.benefits.slice(0,3) : ['Benefit contoh 1', 'Benefit contoh 2'])">
              <div class="flex items-start gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-green-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-xs font-medium text-gray-700 leading-tight" x-text="benefit"></span>
              </div>
            </template>
            <div x-show="service.benefits.length > 3" class="text-xs text-gray-400 font-medium italic" x-text="'+ ' + (service.benefits.length - 3) + ' benefit lainnya'"></div>
          </div>

          <!-- Price -->
          <div class="mb-6">
            <p class="text-xs text-gray-500 font-medium mb-1">Mulai Dari</p>
            <div class="text-lg font-extrabold text-primary" x-text="service.price_starts_from || 'Rp -'"></div>
          </div>
          
          <!-- CTA -->
          <div class="w-full py-3 bg-gray-50 text-dark text-sm font-semibold rounded-xl border border-gray-200 text-center">
            <span x-text="service.cta_text || 'Pelajari Lebih Lanjut'"></span>
          </div>
        </div>
        <p class="text-[10px] text-gray-400 text-center mt-2">* Tampilan ini adalah perkiraan (preview)</p>
      </div>
    </div>
  </form>
</AdminLayout>

<script define:vars={{ serviceId: id, initialData }}>
  window.__EDIT_SERVICE_ID__ = serviceId;
  window.__EDIT_INITIAL_DATA__ = initialData;
</script>

<script>
  import { supabase } from '../../../../lib/supabase';

  document.addEventListener('alpine:init', () => {
    window.Alpine.data('editServiceData', () => {
      // Initialize with fallbacks for new fields if they don't exist in old DB rows
      let initData = window.__EDIT_INITIAL_DATA__ || {};
      if (!initData.badges) {
        initData.badges = initData.badge_text ? [initData.badge_text] : [];
      }
      if (!initData.benefits) initData.benefits = [];
      if (!initData.price_starts_from) initData.price_starts_from = '';
      if (!initData.cta_text) initData.cta_text = 'Pelajari Lebih Lanjut';
      if (!initData.cta_link) initData.cta_link = '';
      if (initData.order_index === undefined) initData.order_index = 0;
      if (initData.is_active === undefined) initData.is_active = true;

      return {
        submitting: false,
        newBadge: '',
        newBenefit: '',
        service: initData,

        init() {
          this.$watch('service.icon', () => {
            setTimeout(() => {
              if (window.lucide) window.lucide.createIcons();
            }, 50);
          });
        },

        addBadge() {
          if (this.newBadge.trim()) {
            this.service.badges.push(this.newBadge.trim());
            if (!this.service.badge_text) this.service.badge_text = this.service.badges[0];
            this.newBadge = '';
          }
        },
        
        removeBadge(index) {
          this.service.badges.splice(index, 1);
          if (this.service.badges.length > 0) {
            this.service.badge_text = this.service.badges[0];
          } else {
            this.service.badge_text = '';
          }
        },

        addBenefit() {
          if (this.newBenefit.trim()) {
            this.service.benefits.push(this.newBenefit.trim());
            this.newBenefit = '';
          }
        },
        
        removeBenefit(index) {
          this.service.benefits.splice(index, 1);
        },
        
        moveBenefit(index, direction) {
          const newIndex = index + direction;
          if (newIndex < 0 || newIndex >= this.service.benefits.length) return;
          const temp = this.service.benefits[newIndex];
          this.service.benefits[newIndex] = this.service.benefits[index];
          this.service.benefits[index] = temp;
        },

        generateSlug() {
          this.service.slug = this.service.title
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/[\s_-]+/g, '-')
            .replace(/^-+|-+$/g, '');
        },

        async updateService() {
          if (!this.service.title || !this.service.slug || !this.service.description) {
            alert('Mohon isi field yang wajib!');
            return;
          }

          this.submitting = true;
          try {
            // Need to handle missing columns gracefully
            const { error } = await supabase
              .from('services')
              .update(this.service)
              .eq('id', window.__EDIT_SERVICE_ID__);

            if (error) {
              if (error.code === '42703' || error.message.includes('column') || error.message.includes('does not exist')) {
                console.warn("New columns not found in DB. Falling back to old schema update.");
                
                const fallbackItem = {
                  title: this.service.title,
                  slug: this.service.slug,
                  description: this.service.description,
                  badge_text: this.service.badges.length > 0 ? this.service.badges[0] : this.service.badge_text,
                  icon: this.service.icon
                };

                const { error: fallbackError } = await supabase
                  .from('services')
                  .update(fallbackItem)
                  .eq('id', window.__EDIT_SERVICE_ID__);

                if (fallbackError) throw fallbackError;
                
                alert('Layanan berhasil diperbarui (Data Terbatas). Beberapa field baru tidak tersimpan karena database belum dimigrasi.');
              } else if (error.code === '23505') {
                alert('Slug sudah digunakan.');
                return;
              } else {
                throw error;
              }
            } else {
               alert('Layanan berhasil diperbarui!');
            }
            
            window.location.href = '/admin/services';
          } catch (error) {
            console.error('Error updating service:', error);
            alert('Gagal memperbarui layanan.');
          } finally {
            this.submitting = false;
          }
        }
      };
    });
  });
</script>
