---

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: services } = await supabase.from('services').select('slug');
  return (services || []).map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;

const { data: service, error } = await supabase
  .from('services')
  .select('title, description')
  .eq('slug', slug)
  .single();

if (error || !service) {
  return Astro.redirect('/404');
}
---

<Layout title={`${service.title} | Layanan Digital Agency Sumbawa - Pinabae Studio`} description={service.description.substring(0, 160).replace(/<[^>]*>?/gm, '')}>
  <Navbar />
  
  <main class="flex-grow pt-32">
    <Section>
      <div class="max-w-4xl mx-auto">
        <Breadcrumb items={[{ label: "Layanan Kami", href: "/layanan" }, { label: service.title }]} />
        
        <div class="header-anim opacity-0 translate-y-8 mt-6">
          <h1 class="text-4xl md:text-5xl font-bold text-dark mb-6">{service.title}</h1>
        </div>

        <div class="prose prose-lg prose-orange max-w-none text-text content-anim opacity-0 translate-y-8" set:html={service.description}>
        </div>

        <div class="mt-16 pt-8 border-t border-border flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between content-anim opacity-0 translate-y-8">
          <p class="text-lg font-medium text-dark">Tertarik dengan layanan ini?</p>
          <a href={`https://wa.me/6282339265052?text=${encodeURIComponent(`Halo Pinabae Studio, saya tertarik untuk berdiskusi mengenai layanan *${service.title}*.`)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center font-medium transition-all duration-300 rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 bg-primary text-white hover:bg-secondary focus:ring-primary shadow-md hover:shadow-lg px-5 py-2.5 text-sm sm:px-8 sm:py-4 sm:text-lg w-full sm:w-auto text-center">
            Konsultasi Sekarang
          </a>
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

<script>
  import gsap from 'gsap';
  document.addEventListener('astro:page-load', () => {

if (typeof window !== 'undefined') {
      const initAnim = () => {
        gsap.to('.header-anim', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' });
        gsap.to('.content-anim', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 0.2, stagger: 0.2 });
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initAnim);
      } else {
        setTimeout(initAnim, 100);
      }
    }

  });
</script>
