---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import { supabase } from '../../lib/supabase';

const { data: services } = await supabase
  .from('services')
  .select('*')
  .order('created_at', { ascending: true });
---

<Layout title="Layanan Kami | Pinabae Studio" description="Solusi digital untuk membangun kredibilitas, meningkatkan visibilitas, dan mendukung pertumbuhan bisnis Anda.">
  <Navbar />

  <main class="flex-grow pt-32">
    
    <!-- Hero / Section 1: Masalah -->
    <Section class="pb-16 md:pb-24">
      <div class="max-w-3xl mx-auto text-center mb-16 header-anim opacity-0 translate-y-8">
        <h1 class="text-4xl md:text-5xl font-extrabold text-dark tracking-tight leading-tight mb-6">
          Apakah Bisnis Anda Mengalami Salah Satu Tantangan Ini?
        </h1>
        <p class="text-lg md:text-xl text-text leading-relaxed">
          Banyak bisnis memiliki produk atau layanan yang berkualitas, tetapi belum memiliki kehadiran digital yang mampu membangun kepercayaan, menjangkau pelanggan baru, dan mendukung pertumbuhan bisnis.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto problem-cards">
        {[
          { icon: 'user-search', title: 'Sulit Menjangkau Pelanggan Baru', desc: 'Bisnis Anda belum memiliki media digital yang mampu menarik perhatian calon pelanggan secara konsisten.' },
          { icon: 'search-x', title: 'Sulit Ditemukan di Google', desc: 'Website belum dioptimalkan sehingga calon pelanggan kesulitan menemukan bisnis Anda melalui mesin pencari.' },
          { icon: 'shield-alert', title: 'Kurang Dipercaya Calon Pelanggan', desc: 'Tidak memiliki website profesional dapat mengurangi kredibilitas bisnis di mata calon pelanggan.' },
          { icon: 'trending-down', title: 'Penjualan Belum Maksimal', desc: 'Media digital yang kurang efektif membuat peluang mendapatkan leads dan penjualan menjadi lebih rendah.' },
          { icon: 'monitor-off', title: 'Website Belum Memberikan Hasil', desc: 'Website sudah ada, tetapi belum mampu mendukung tujuan bisnis maupun menghasilkan konversi yang optimal.' },
        ].map(problem => (
          <div class="bg-white rounded-2xl p-6 md:p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-300 problem-card opacity-0 translate-y-8">
            <div class="w-12 h-12 rounded-xl bg-orange-50 text-primary flex items-center justify-center mb-6">
              <i data-lucide={problem.icon} class="w-6 h-6"></i>
            </div>
            <h3 class="text-xl font-bold text-dark mb-3">{problem.title}</h3>
            <p class="text-text leading-relaxed text-sm md:text-base">{problem.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 md:mt-16 max-w-2xl mx-auto header-anim opacity-0 translate-y-8">
        <p class="text-lg font-medium text-dark/80 px-4 py-3 bg-gray-50 rounded-2xl inline-block">
          Apa pun tantangan bisnis Anda, Pinabae Studio siap membantu melalui solusi digital yang dirancang sesuai kebutuhan dan tujuan bisnis.
        </p>
      </div>
    </Section>

    <!-- Section 2: Solusi Digital (Admin Data) -->
    <Section class="py-20 md:py-28 bg-gray-50/50">
      <div class="max-w-3xl mx-auto text-center mb-16 services-header opacity-0 translate-y-8">
        <span class="inline-block text-primary font-bold tracking-wider text-sm mb-4 uppercase">Layanan Kami</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">
          Pilih Solusi Digital yang Tepat untuk Bisnis Anda
        </h2>
        <p class="text-lg text-text leading-relaxed">
          Setiap bisnis memiliki kebutuhan yang berbeda. Pilih layanan yang paling sesuai untuk membangun kredibilitas, meningkatkan visibilitas, dan mendukung pertumbuhan bisnis Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto cards-container">
        {services && services.length > 0 ? (
          services.map((service: any) => (
            <div class="group bg-white rounded-3xl p-8 border border-gray-200/60 transition-all duration-300 ease-out hover:-translate-y-2 hover:scale-[1.02] hover:border-primary/50 hover:shadow-[0_20px_40px_-15px_rgba(245,124,0,0.15)] service-card opacity-0 translate-y-8 flex flex-col h-full relative overflow-hidden">
              <div class="flex justify-between items-start mb-8">
                <div class="w-16 h-16 rounded-2xl bg-orange-50 flex items-center justify-center group-hover:bg-primary transition-colors duration-300">
                  <i data-lucide={service.icon || "box"} class="text-primary w-8 h-8 group-hover:text-white transition-colors duration-300"></i>
                </div>
                {service.badge_text && (
                  <span class="inline-block px-4 py-1.5 bg-orange-50 text-primary text-xs font-bold uppercase tracking-wider rounded-full border border-orange-100">{service.badge_text}</span>
                )}
              </div>
              <h3 class="text-2xl font-bold text-dark mb-4 tracking-tight group-hover:text-primary transition-colors duration-300">{service.title}</h3>
              <p class="text-text leading-relaxed mb-8 flex-grow line-clamp-3">
                {service.description.replace(/<[^>]*>?/gm, '')}
              </p>
              <a href={`/layanan/${service.slug}`} class="inline-flex items-center gap-2 text-dark font-semibold group-hover:text-primary transition-colors duration-300 mt-auto">
                Pelajari Lebih Lanjut <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-300"></i>
              </a>
            </div>
          ))
        ) : (
          <div class="col-span-full text-center py-12 text-gray-500 bg-white rounded-2xl border border-dashed border-gray-300">
            Belum ada layanan yang ditambahkan.
          </div>
        )}
      </div>
    </Section>

    <!-- Section 3: Perbandingan Layanan -->
    <Section class="py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center mb-16 compare-header opacity-0 translate-y-8">
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight mb-6">
          Mana Solusi yang Tepat untuk Bisnis Anda?
        </h2>
        <p class="text-lg text-text leading-relaxed">
          Bandingkan setiap layanan untuk menemukan solusi digital yang paling sesuai dengan kebutuhan dan tujuan bisnis Anda.
        </p>
      </div>

      <div class="max-w-5xl mx-auto overflow-x-auto pb-4 compare-table opacity-0 translate-y-8">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-gray-100">
              <th class="py-5 px-6 font-bold text-dark text-lg whitespace-nowrap">Layanan</th>
              <th class="py-5 px-6 font-bold text-dark text-lg whitespace-nowrap">Cocok Untuk</th>
              <th class="py-5 px-6 font-bold text-dark text-lg min-w-[300px]">Tujuan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {[
              { title: 'Company Profile', icon: 'building-2', target: 'UMKM, Perusahaan, Instansi', goal: 'Membangun kredibilitas bisnis dan memperkenalkan profil perusahaan secara profesional.' },
              { title: 'Landing Page', icon: 'layout-template', target: 'Produk, Campaign, Jasa', goal: 'Meningkatkan konversi, menghasilkan leads, dan mendukung aktivitas pemasaran.' },
              { title: 'Portfolio Website', icon: 'briefcase', target: 'Freelancer, Kreator, Profesional', goal: 'Menampilkan karya, pengalaman, dan memperkuat personal branding.' },
              { title: 'SEO Optimization', icon: 'search', target: 'Website yang Sudah Online', goal: 'Meningkatkan visibilitas di Google, mendatangkan trafik organik, dan menjangkau lebih banyak pelanggan.' },
            ].map(row => (
              <tr class="group hover:bg-gray-50 transition-colors duration-200">
                <td class="py-5 px-6 font-semibold text-dark flex items-center gap-3 whitespace-nowrap">
                  <i data-lucide={row.icon} class="w-5 h-5 text-primary"></i>
                  {row.title}
                </td>
                <td class="py-5 px-6 text-text whitespace-nowrap">{row.target}</td>
                <td class="py-5 px-6 text-text leading-relaxed">{row.goal}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <!-- Section 4: CTA -->
    <Section class="py-20 md:py-24">
      <div class="max-w-5xl mx-auto bg-gradient-to-br from-primary via-orange-500 to-orange-600 rounded-[2rem] p-10 md:p-16 text-white text-center shadow-xl cta-section opacity-0 translate-y-8">
        <h2 class="text-3xl md:text-5xl font-extrabold mb-6 tracking-tight">
          Siap Mengembangkan Bisnis Anda Secara Digital?
        </h2>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto mb-10 leading-relaxed">
          Mari diskusikan kebutuhan bisnis Anda bersama Pinabae Studio. Kami akan membantu menentukan solusi digital yang tepat untuk membangun kredibilitas, menjangkau lebih banyak pelanggan, dan mendukung pertumbuhan bisnis Anda.
        </p>
        
        <div class="flex flex-wrap justify-center gap-6 mb-12">
          {[
            'Konsultasi Gratis',
            'Harga Transparan',
            'Solusi Sesuai Kebutuhan',
            'Support Setelah Project Selesai'
          ].map(check => (
            <div class="flex items-center gap-2 text-white/95 font-medium">
              <i data-lucide="check-circle" class="w-5 h-5 text-white"></i>
              {check}
            </div>
          ))}
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener noreferrer" class="bg-white text-primary hover:bg-gray-50 font-bold py-4 px-8 rounded-xl transition-all duration-300 hover:shadow-lg hover:-translate-y-1 w-full sm:w-auto inline-flex items-center justify-center gap-2">
            <i data-lucide="message-circle" class="w-5 h-5"></i>
            Konsultasi via WhatsApp
          </a>
          <a href="/kontak" class="bg-black/20 text-white hover:bg-black/30 font-bold py-4 px-8 rounded-xl transition-all duration-300 w-full sm:w-auto backdrop-blur-sm border border-white/10">
            Hubungi Kami
          </a>
        </div>
        <p class="mt-6 text-sm text-white/70 font-medium">
          Respon pada jam kerja • Konsultasi tanpa biaya • Tanpa komitmen
        </p>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { createIcons, icons } from 'lucide';

  gsap.registerPlugin(ScrollTrigger);

  // Initialize lucide icons for dynamically added elements
  createIcons({ icons });

  // Section 1
  gsap.to('.header-anim', { opacity: 1, y: 0, duration: 1, ease: 'power3.out', stagger: 0.2 });
  
  gsap.to('.problem-card', {
    scrollTrigger: {
      trigger: '.problem-cards',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    stagger: 0.1,
    duration: 0.8,
    ease: 'power3.out'
  });

  // Section 2
  gsap.to('.services-header', {
    scrollTrigger: {
      trigger: '.services-header',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out'
  });

  gsap.to('.service-card', {
    scrollTrigger: {
      trigger: '.cards-container',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    stagger: 0.15,
    duration: 0.8,
    ease: 'power3.out'
  });

  // Section 3
  gsap.to('.compare-header', {
    scrollTrigger: {
      trigger: '.compare-header',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out'
  });

  gsap.to('.compare-table', {
    scrollTrigger: {
      trigger: '.compare-table',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out',
    delay: 0.2
  });

  // Section 4
  gsap.to('.cta-section', {
    scrollTrigger: {
      trigger: '.cta-section',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    duration: 1,
    ease: 'power3.out'
  });
</script>
