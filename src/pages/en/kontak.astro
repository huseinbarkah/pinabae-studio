---

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Section from '../../components/ui/Section.astro';
import Input from '../../components/ui/Input.astro';
import Button from '../../components/ui/Button.astro';
---

<Layout title="Contact Us | Pinabae Studio" description="Consult your website and digital marketing needs with Pinabae Studio.">
  <Navbar />
  
  <main class="flex-grow pt-32">
    <Section>
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
          
          <div class="header-anim opacity-0 translate-y-8">
            <h1 class="text-4xl md:text-5xl font-bold text-dark mb-6">Let's Talk</h1>
            <p class="text-lg text-text mb-10">Tell us about your business and what you want to achieve. We'll help design the right website solutions.</p>
            
            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center text-dark shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <h3 class="font-bold text-dark">WhatsApp</h3>
                  <p class="text-text">+62 823-3926-5052</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center text-dark shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <div>
                  <h3 class="font-bold text-dark">Email</h3>
                  <p class="text-text">pinabaestudio@gmail.com</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center text-dark shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                </div>
                <div>
                  <h3 class="font-bold text-dark">Instagram</h3>
                  <p class="text-text">@pinabaestudio</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="bg-white p-8 rounded-3xl border border-border shadow-lg form-anim opacity-0 translate-y-8">
            <form id="waForm" class="space-y-6">
              <h3 class="text-2xl font-bold text-dark mb-6">Send a Message</h3>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <Input name="name" label="Full Name" required={true} placeholder="Ex: John Doe" />
                <Input name="phone" type="tel" label="Your WhatsApp Number" required={true} placeholder="Ex: 08123456789" />
              </div>
              
              <Input name="email" type="email" label="Email Address" required={true} placeholder="Ex: john@email.com" />
              <Input name="subject" label="Subject / Service" required={true} placeholder="Ex: E-Commerce Website Development" />
              <Input name="message" label="Your Message" required={true} textarea={true} rows={5} placeholder="Tell us the details of your needs..." />
              
              <Button type="submit" class="w-full">Send via WhatsApp</Button>
            </form>
          </div>
          
        </div>
      </div>
    </Section>
  </main>

  <Footer />
</Layout>

<script>
  import gsap from 'gsap';
  document.addEventListener('astro:page-load', () => {

if (typeof window !== 'undefined') {
      const initAnim = () => {
        gsap.to('.header-anim', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' });
        gsap.to('.form-anim', { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out', delay: 0.2 });
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initAnim);
      } else {
        setTimeout(initAnim, 100);
      }
    }
  
    const form = document.getElementById('waForm') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const formData = new FormData(form);
        const name = formData.get('name');
        const phone = formData.get('phone');
        const email = formData.get('email');
        const subject = formData.get('subject');
        const message = formData.get('message');
        
        const targetWa = '6282339265052'; // Ganti dengan nomor WA tujuan Anda
        
        const text = `Hello Pinabae Studio, I would like to discuss your services.%0A%0A*Name:* ${name}%0A*WhatsApp:* ${phone}%0A*Email:* ${email}%0A*Subject:* ${subject}%0A%0A*Message:*%0A${message}`;
        
        const waUrl = `https://wa.me/${targetWa}?text=${text}`;
        window.open(waUrl, '_blank');
      });
    }

  });
</script>
