---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'en' ? '/en' : '';
---

<footer class="bg-section border-t border-border mt-20 pt-16 pb-8 overflow-hidden">
  <div class="container mx-auto px-6 footer-anim opacity-0 translate-y-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Column 1: Tentang Pinabae Studio -->
      <div class="flex flex-col">
        <a href={`${basePath}/`} class="mb-6 hover:opacity-80 transition-opacity inline-flex">
          <Image src={logoImg} alt="Pinabae Studio Logo" class="h-16 w-auto" width={128} height={128} loading="lazy" />
        </a>
        <p class="text-text leading-relaxed mb-6">
          {t('footer.description')}
        </p>
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-100 rounded-full text-sm text-text font-medium shadow-sm w-fit mt-auto">
          <i data-lucide="map-pin" class="w-4 h-4 text-primary"></i>
          {t('footer.location')}
        </div>
      </div>
      
      <!-- Column 2: Layanan -->
      <div>
        <h3 class="font-bold text-dark text-lg mb-6">{t('footer.services')}</h3>
        <ul class="space-y-4">
          <li>
            <a href={`${basePath}/layanan/company-profile`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="building-2" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>Company Profile</span>
            </a>
          </li>
          <li>
            <a href={`${basePath}/layanan/portfolio-website`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="user-square" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>Portfolio Website</span>
            </a>
          </li>
          <li>
            <a href={`${basePath}/layanan/landing-page`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="layout-template" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>Landing Page</span>
            </a>
          </li>
          <li>
            <a href={`${basePath}/layanan/seo-optimization`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="search" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>SEO Optimization</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Perusahaan -->
      <div>
        <h3 class="font-bold text-dark text-lg mb-6">{t('footer.company')}</h3>
        <ul class="space-y-4">
          <li>
            <a href={`${basePath}/tentang`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="info" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>{t('footer.about')}</span>
            </a>
          </li>
          <li>
            <a href={`${basePath}/portfolio`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="briefcase-business" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>{t('nav.portfolio')}</span>
            </a>
          </li>
          <li>
            <a href={`${basePath}/blog`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="book-open" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>{t('nav.blog')}</span>
            </a>
          </li>
          <li>
            <a href={`${basePath}/kontak`} class="group flex items-center gap-3 text-text hover:text-primary transition-colors duration-300">
              <i data-lucide="message-circle" class="w-5 h-5 text-gray-400 group-hover:text-primary transition-colors duration-300"></i>
              <span>{t('footer.contact')}</span>
            </a>
          </li>
        </ul>
      </div>
      
      <!-- Column 4: Kontak & Media Sosial -->
      <div>
        <h3 class="font-bold text-dark text-lg mb-6">{t('footer.contact')}</h3>
        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3 text-text">
            <i data-lucide="map-pin" class="w-5 h-5 text-primary mt-0.5 shrink-0"></i>
            <span class="leading-relaxed">{t('footer.location')}</span>
          </li>
          <li class="flex items-center gap-3 text-text">
            <i data-lucide="mail" class="w-5 h-5 text-primary shrink-0"></i>
            <a href="mailto:pinabae@gmail.com" class="hover:text-primary transition-colors">pinabae@gmail.com</a>
          </li>
          <li class="flex items-center gap-3 text-text">
            <i data-lucide="phone" class="w-5 h-5 text-primary shrink-0"></i>
            <a href="tel:+6282339265052" class="hover:text-primary transition-colors">+62-8233-9265-052</a>
          </li>
          <li class="flex items-start gap-3 text-text">
            <i data-lucide="clock-3" class="w-5 h-5 text-primary mt-0.5 shrink-0"></i>
            <span class="leading-relaxed" set:html={t('footer.hours')}></span>
          </li>
        </ul>
        
        <a href="https://wa.me/6282339265052" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 w-full md:w-auto px-6 py-3 bg-primary text-white font-semibold rounded-full hover:bg-orange-600 hover:scale-105 transition-all duration-300 shadow-sm hover:shadow-md mb-8">
          <i data-lucide="message-square" class="w-5 h-5"></i>
          {t('footer.cta')}
        </a>
        
        <div class="flex items-center gap-5">
          <a href="#" class="text-gray-400 hover:text-primary hover:scale-110 transition-all duration-300" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-primary hover:scale-110 transition-all duration-300" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-primary hover:scale-110 transition-all duration-300" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-primary hover:scale-110 transition-all duration-300" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-primary hover:scale-110 transition-all duration-300" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
        </div>
      </div>
      
    </div>
    
    <!-- Footer Bottom -->
    <div class="border-t border-gray-200/80 pt-8 flex flex-col md:flex-row items-center justify-between text-sm text-gray-500 gap-4">
      <p>&copy; {new Date().getFullYear()} Pinabae Studio. {t('footer.rights')}</p>
      <div class="flex items-center gap-6">
        <a href={`${basePath}/privacy-policy`} class="hover:text-primary transition-colors">Privacy Policy</a>
        <a href={`${basePath}/terms-conditions`} class="hover:text-primary transition-colors">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate footer fade-up when visible
  if (typeof window !== 'undefined') {
    const initAnim = () => {
      gsap.to('.footer-anim', {
        scrollTrigger: {
          trigger: '.footer-anim',
          start: 'top 90%',
          once: true
        },
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out'
      });
    };
    if ('requestIdleCallback' in window) {
      requestIdleCallback(initAnim);
    } else {
      setTimeout(initAnim, 100);
    }
  }
</script>
