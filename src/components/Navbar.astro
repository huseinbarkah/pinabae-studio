---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const pathname = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = lang === 'en' ? '/en' : '';

const navLinks = [
  { name: t('nav.home'), href: `${basePath}/` },
  { name: t('nav.about'), href: `${basePath}/tentang` },
  { name: t('nav.services'), href: `${basePath}/layanan` },
  { name: t('nav.portfolio'), href: `${basePath}/portfolio` },
  { name: t('nav.blog'), href: `${basePath}/blog` },
  { name: t('nav.contact'), href: `${basePath}/kontak` },
];

const isActive = (href: string) => {
  if (href === '/' || href === '/en/') {
    return pathname === '/' || pathname === '' || pathname === '/en' || pathname === '/en/';
  }
  return pathname.startsWith(href);
};

// Function to generate equivalent URL for language switcher
const getUrlForLang = (targetLang: string) => {
  let path = pathname;
  if (path.startsWith('/en/')) path = path.replace('/en/', '/');
  else if (path === '/en') path = '/';
  
  if (targetLang === 'id') return path;
  if (path === '/') return '/en/';
  return `/en${path}`;
};
---

<header id="navbar" x-data="{ mobileMenuOpen: false }" class="fixed top-0 md:top-6 w-full md:w-[90%] md:max-w-5xl md:left-0 md:right-0 md:mx-auto z-50 bg-white/60 backdrop-blur-lg border-b md:border border-border/50 md:rounded-full transition-all duration-300 md:shadow-md">
  <div class="w-full px-6 md:px-8 h-20 md:h-16 flex items-center justify-between">
    <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
      <Image src={logoImg} alt="Pinabae Studio Logo" class="h-14 w-auto" width={112} height={112} loading="eager" fetchpriority="high" />
    </a>
    
    <nav class="hidden md:flex items-center gap-4 lg:gap-8 font-medium text-sm lg:text-base">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`transition-colors hover:text-primary ${isActive(link.href) ? 'text-primary font-bold' : 'text-text'}`}
        >
          {link.name}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-4">
      <div class="flex items-center bg-gray-100 rounded-full p-1 border border-gray-200/60">
        <a href={getUrlForLang('id')} class={`px-4 py-1.5 rounded-full text-sm font-bold transition-colors ${lang === 'id' ? 'bg-white shadow-sm text-primary' : 'text-gray-500 hover:text-dark'}`}>ID</a>
        <a href={getUrlForLang('en')} class={`px-4 py-1.5 rounded-full text-sm font-bold transition-colors ${lang === 'en' ? 'bg-white shadow-sm text-primary' : 'text-gray-500 hover:text-dark'}`}>EN</a>
      </div>
    </div>

    <button x-on:click="mobileMenuOpen = !mobileMenuOpen" class="md:hidden text-dark p-2" aria-label="Menu">
      <svg x-show="!mobileMenuOpen" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg x-show="mobileMenuOpen" style="display: none;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div 
    x-show="mobileMenuOpen" 
    style="display: none;"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="md:hidden absolute top-20 left-0 w-full bg-white border-b border-border shadow-lg"
  >
    <nav class="flex flex-col px-6 py-6 gap-4 font-medium">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`transition-colors py-2 border-b border-gray-100 ${isActive(link.href) ? 'text-primary font-bold' : 'text-text'}`}
        >
          {link.name}
        </a>
      ))}
      <div class="mt-4 flex items-center justify-center bg-gray-100 rounded-full p-1 border border-gray-200/60 w-full">
        <a href={getUrlForLang('id')} class={`flex-1 text-center py-2 rounded-full text-sm font-bold transition-colors ${lang === 'id' ? 'bg-white shadow-sm text-primary' : 'text-gray-500 hover:text-dark'}`}>ID</a>
        <a href={getUrlForLang('en')} class={`flex-1 text-center py-2 rounded-full text-sm font-bold transition-colors ${lang === 'en' ? 'bg-white shadow-sm text-primary' : 'text-gray-500 hover:text-dark'}`}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    let lastScroll = 0;
    const navbar = document.getElementById('navbar');

    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;
      
      // Always show at the very top
      if (currentScroll <= 0) {
        navbar?.classList.remove('-translate-y-32');
        return;
      }
      
      // Hide when scrolling down, show when scrolling up
      if (currentScroll > lastScroll && !navbar?.classList.contains('-translate-y-32')) {
        navbar?.classList.add('-translate-y-32');
      } else if (currentScroll < lastScroll && navbar?.classList.contains('-translate-y-32')) {
        navbar?.classList.remove('-translate-y-32');
      }
      
      lastScroll = currentScroll;
    });
  });
</script>
